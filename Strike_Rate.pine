//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//                              S T R I K E   R A T E
//                    Signal engine for Indian index options
//                         Lab-tuned defaults · v1.0
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Runs on OPTION charts only (Nifty / Bank Nifty / Sensex CE and PE).
//  The index feed is pulled in automatically for direction — never apply this
//  script to a futures or index chart.
//
//  TWO MODES
//    SNIPER   — 5 signals. Fewer trades, higher hit rate.  ← default
//    SCANNER  — 9 signals. Roughly double the trades, slightly lower hit rate.
//
//  RECOMMENDED SETUP  (from lab + trade-plan research)
//    Sniper · Two must agree · 5-minute signals · T1 10 / T2 30 / Stop 18
//
//  LAB FINDINGS (Nifty CE/PE · multi-strike · Apr–Jul 2025 · this repo)
//    Stop 18 beat tighter stops (10–15 sat inside premium noise and cut winners).
//    Full exit at +10 with SL18 was net-negative — the runner to T2 is required.
//    Half at T1 → stop to entry · half runs to T2 30.
//    Strict confluence (~1 signal/chart/day on ATM) beat looser score gates.
//    Broad panel (~128 runners trades, 40 contracts): ~38% tagged T1, ~32% T2,
//    ~27% T3-class extension, ~63% stopped. ATM and PE months fared better than
//    chasing every ITM strike. Backtests flatter — trade small until your log agrees.
//
//  QUICK START
//    1. Open an ATM option chart, 5-minute.
//    2. Set "Index feed" to the matching futures symbol.
//    3. Pick your mode. Set "Side" from your own pre-market view, or leave Auto.
//    4. Green candles = position open. Red = flat. Pale green = T1 already banked.
//
//  Targets and stop are in OPTION POINTS. Defaults are tuned for Nifty; raise
//  them proportionally for Bank Nifty and Sensex, whose premiums move further.
//
//  ON THE TRADE PLAN
//  Half books at 10 points, half runs to 30, stop at 18. After T1 the stop moves
//  to entry on the runner. Closing the second half early (e.g. at 20) cuts the
//  expectancy that lives in the runner — lab SL18 lock-at-10 was deeply red.
//  Option stops gap: budget ~1.3× the printed stop when you size.
//
//  DASHBOARD figures are calculated on the bars loaded on your chart. They
//  assume entry at the signal bar's close with NO slippage and NO brokerage.
//  Past behaviour is not a forecast. Position size accordingly.
// ═══════════════════════════════════════════════════════════════════════════════

indicator("STRIKE RATE", "STRIKE RATE", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ─────────────────────────── SETTINGS ───────────────────────────
G1 = "①  Setup"
mode     = input.string("Sniper", "Mode", options = ["Sniper", "Scanner"], group = G1, tooltip = "SNIPER — 5 signals, fewer trades, higher quality (lab default).\nSCANNER — 9 signals, more trades, noisier.\n\nLab: strict confluence beat loose score gates on net expectancy.")
side     = input.string("Auto", "Side", options = ["Auto", "Calls only", "Puts only"], group = G1, tooltip = "Set this from your own pre-market view. On a CALL chart with 'Puts only' selected, nothing will fire — that is intended.")
undSym   = input.symbol("NSE:NIFTY1!", "Index feed", group = G1, tooltip = "Use the FUTURES symbol for the index this option belongs to.\nNifty → NSE:NIFTY1!\nBank Nifty → NSE:BANKNIFTY1!\nSensex → BSE:SENSEX1!")
sigTF    = input.timeframe("5", "Signal timeframe", options = ["1", "3", "5", "15"], group = G1, tooltip = "SIGNALS are calculated on this TF — separate from the chart you view.\n\nKeep at 5. View on 1m/3m for finer entries if you want.\n1 or 3 here is a different, less-tested system.")
optType  = input.string("Auto", "Option type", options = ["Auto", "Call", "Put"], group = G1, tooltip = "Auto reads CE/PE from the ticker. Override only if the panel shows the wrong type.")

G2 = "②  Trade plan  (option points)"
tp1p = input.float(10.0, "Target 1", minval = 1, step = 1, group = G2, tooltip = "Half the position books here; stop on the runner moves to entry.\n\nNifty 10 · Bank Nifty ~25 · Sensex ~20\n\nLab: locking the WHOLE trade at +10 with SL18 was net-negative. Half-out here funds the stop-gap risk; the edge sits in the runner.")
tp2p = input.float(30.0, "Target 2", minval = 1, step = 1, group = G2, tooltip = "Remaining half runs here. Lab: letting winners extend past +10 was required for SL18 to have a chance. Capping the runner at 20 measurably hurts.")
slp  = input.float(18.0, "Stop", minval = 1, step = 1, group = G2, tooltip = "18 is deliberate.\n\nLab grid (same entries): SL10–15 sat inside noise and cut trades that later reached +10. SL18 was the first balanced stop that stayed usable; SL30 tagged +10 more often but loses harder when wrong.\n\nOption premiums gap through stops — size for ~1.3× fill.")

G3 = "③  Session"
sesOn   = input.bool(true, "Use session filter", group = G3)
sesTime = input.session("0920-1445", "Trading hours", group = G3)
muteOn  = input.bool(true, "Skip midday", group = G3, tooltip = "Blocks new entries during the low-volatility lunch window.")
muteSes = input.session("1215-1315", "Midday window", group = G3)
flatSes = input.session("1510-1520", "Exit all by", group = G3)

G4 = "④  Display"
showTbl   = input.bool(true, "Dashboard", group = G4)
showPnl   = input.bool(true, "Live panel", group = G4)
paint     = input.bool(true, "Paint candles", group = G4)
showLbl   = input.bool(true, "Signal labels", group = G4)
showPx    = input.bool(true, "Show entry price on the buy label", group = G4)
showEarly = input.bool(true, "Early warning dot", group = G4, tooltip = "Dot under the bar when an engine fires BEFORE bar close / confirmed BUY.\nHeads-up only — can vanish. Excluded from dashboard stats.")
showZone  = input.bool(true, "Draw target / stop zones", group = G4)
tblPos    = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G4)
tblSize   = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G4)
chartSig  = input.string("Two must agree", "Chart signals from", options = ["Any engine", "Two must agree", "Anchor", "Ignition", "Drift", "Surge"], group = G4, tooltip = "Drives BUY/EXIT labels, candle colour, live panel, alerts.\n\nTWO MUST AGREE — lab default. Strict confluence, ~1 signal/day class frequency on ATM.\nANY ENGINE — more signals, lower quality.\nOr follow a single named engine.\n\nDashboard always lists every enabled engine.")

// ─────────────────────────── INTERNAL ───────────────────────────
scanner = mode == "Scanner"
consN   = chartSig == "Two must agree" ? 2 : 1
dIdx    = chartSig == "Anchor" ? 0 : chartSig == "Ignition" ? 2 : chartSig == "Drift" ? 3 : chartSig == "Surge" ? 7 : 8

tkr = str.upper(syminfo.ticker)
aCE = str.endswith(tkr, "CE") or not na(str.match(tkr, "[0-9]C[0-9]+$")) or str.contains(tkr, "CALL")
aPE = str.endswith(tkr, "PE") or not na(str.match(tkr, "[0-9]P[0-9]+$")) or str.contains(tkr, "PUT")
isCE = optType == "Call" ? true : optType == "Put" ? false : aCE ? true : aPE ? false : true

[uO, uH, uL, uC, uV] = request.security(undSym, sigTF, [open, high, low, close, volume], barmerge.gaps_off, barmerge.lookahead_off)
dO = uO
dH = uH
dL = uL
dC = uC
dV = nz(uV) <= 0 ? nz(volume) : uV

dTR  = math.max(dH - dL, math.max(math.abs(dH - nz(dC[1], dC)), math.abs(dL - nz(dC[1], dC))))
dAtr = ta.rma(dTR, 14)
[pdH, pdL, pdC] = request.security(undSym, "D", [high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_on)
newDay = ta.change(time("D")) != 0

var float cPV = 0.0
var float cV  = 0.0
dTyp = (dH + dL + dC) / 3
if newDay
    cPV := 0.0
    cV  := 0.0
cPV := cPV + dTyp * dV
cV  := cV + dV
vwap = cV > 0 ? cPV / cV : dC

pP  = (pdH + pdL + pdC) / 3
pB0 = (pdH + pdL) / 2
pT0 = 2 * pP - pB0
pTC = math.max(pT0, pB0)
pBC = math.min(pT0, pB0)
pR1 = 2 * pP - pdL
pS1 = 2 * pP - pdH

var int   dayStart = na
var float orH = na
var float orL = na
var bool  orUp = false
var bool  orDn = false
if newDay
    dayStart := time
    orH      := dH
    orL      := dL
    orUp     := false
    orDn     := false
minsIn = na(dayStart) ? 0.0 : (time - dayStart) / 60000.0
inOR   = minsIn < 30
if inOR and not newDay
    orH := math.max(nz(orH, dH), dH)
    orL := math.min(nz(orL, dL), dL)
orDone = not inOR and not na(orH)
if orDone and dC > orH
    orUp := true
if orDone and dC < orL
    orDn := true

f_st(h, l, c, fac, len) =>
    tr  = math.max(h - l, math.max(math.abs(h - nz(c[1], c)), math.abs(l - nz(c[1], c))))
    atr = ta.rma(tr, len)
    mid = (h + l) / 2
    ub  = mid + fac * atr
    lb  = mid - fac * atr
    var float fu = 0.0
    var float fl = 0.0
    var int   d  = 1
    fu := (ub < nz(fu[1], ub) or nz(c[1], c) > nz(fu[1], ub)) ? ub : nz(fu[1], ub)
    fl := (lb > nz(fl[1], lb) or nz(c[1], c) < nz(fl[1], lb)) ? lb : nz(fl[1], lb)
    d  := c > nz(fu[1], ub) ? 1 : c < nz(fl[1], lb) ? -1 : nz(d[1], 1)
    [d == 1 ? fl : fu, d]
[sf, dirF] = f_st(dH, dL, dC, 1.5, 7)
[ss, dirS] = f_st(dH, dL, dC, 3.0, 10)

e9  = ta.ema(dC, 9)
e21 = ta.ema(dC, 21)
e50 = ta.ema(dC, 50)
slUp = (e50 - e50[3]) > 0
slDn = (e50 - e50[3]) < 0
xUp = ta.crossover(e9, e21)
xDn = ta.crossunder(e9, e21)
sXU = ta.barssince(xUp)
sXD = ta.barssince(xDn)

bbD = 2.0 * ta.stdev(dC, 20)
kcR = ta.rma(dTR, 20) * 1.5
sqz = bbD < kcR
fire = not sqz and sqz[1]
ref  = math.avg(math.avg(ta.highest(dH, 20), ta.lowest(dL, 20)), ta.sma(dC, 20))
mom  = ta.linreg(dC - ref, 20, 0)
sF   = ta.barssince(fire)

ph = ta.pivothigh(dH, 5, 5)
pl = ta.pivotlow(dL, 5, 5)
var float lPH = na
var float lPL = na
if not na(ph)
    lPH := ph
if not na(pl)
    lPL := pl
var float bUp = na
var float bDn = na

vS  = ta.sma(dV, 20)
wid = (dH - dL) > 1.2 * dAtr
tTh = (dH - dL) > 0 and (dC - dL) > 0.66 * (dH - dL)
bTh = (dH - dL) > 0 and (dH - dC) > 0.66 * (dH - dL)

// ── signal definitions ──
a1B = ta.crossover(dC, pTC) or ta.crossover(dC, pR1) or (dL <= pS1 and dC > pS1 and dC > dO)
a1S = ta.crossunder(dC, pBC) or ta.crossunder(dC, pS1) or (dH >= pR1 and dC < pR1 and dC < dO)
x1B = ta.crossunder(dC, pBC) or ta.crossunder(dC, pP)
x1S = ta.crossover(dC, pTC) or ta.crossover(dC, pP)

a2B = ta.crossover(dC, vwap) and dC > dO and (dC - vwap) >= 0.30 * dAtr
a2S = ta.crossunder(dC, vwap) and dC < dO and (vwap - dC) >= 0.30 * dAtr
x2B = ta.crossunder(dC, vwap)
x2S = ta.crossover(dC, vwap)

a3B = orUp[1] and dL <= orH and dC > orH and dC > dO
a3S = orDn[1] and dH >= orL and dC < orL and dC < dO
oM  = (nz(orH) + nz(orL)) / 2
x3B = dC < orH and dC < oM
x3S = dC > orL and dC > oM

a4B = dirF == 1 and dirS == 1 and (dirF[1] != 1 or dirS[1] != 1)
a4S = dirF == -1 and dirS == -1 and (dirF[1] != -1 or dirS[1] != -1)
x4B = dirF == -1
x4S = dirF == 1

a5B = not na(sXU) and sXU <= 3 and e21 > e50 and slUp
a5S = not na(sXD) and sXD <= 3 and e21 < e50 and slDn
x5B = ta.crossunder(e9, e21)
x5S = ta.crossover(e9, e21)

a6B = not na(sF) and sF <= 3 and mom > 0 and mom > mom[1]
a6S = not na(sF) and sF <= 3 and mom < 0 and mom < mom[1]
x6B = mom < 0 or (mom < mom[1] and mom[1] < mom[2])
x6S = mom > 0 or (mom > mom[1] and mom[1] > mom[2])

a7B = not na(lPH) and ta.crossover(dC, lPH)
a7S = not na(lPL) and ta.crossunder(dC, lPL)
if a7B
    bUp := lPH
if a7S
    bDn := lPL
x7B = not na(bUp) and dC < bUp
x7S = not na(bDn) and dC > bDn

a8B = dV > 2.0 * vS and wid and tTh and dC > dO
a8S = dV > 2.0 * vS and wid and bTh and dC < dO
x8B = ta.crossunder(e9, e21) or (dV > 2.0 * vS and bTh and dC < dO)
x8S = ta.crossover(e9, e21) or (dV > 2.0 * vS and tTh and dC > dO)

f_pick(b, s) => isCE ? b : s
premOK = close > close[1]

// ─────────────────────────── FILTERS ───────────────────────────
inSes  = not na(time(timeframe.period, sesTime, "Asia/Kolkata"))
inMute = not na(time(timeframe.period, muteSes, "Asia/Kolkata"))
inFlat = not na(time(timeframe.period, flatSes, "Asia/Kolkata"))
timeOK = not sesOn or (inSes and not (muteOn and inMute))
corr   = ta.correlation(close, uC, 20)
sgn    = isCE ? 1.0 : -1.0
syncOK = nz(corr) * sgn >= 0.30
sideOK = side == "Auto" ? true : side == "Calls only" ? isCE : not isCE
allow  = timeOK and syncOK and sideOK and premOK
flatNow = sesOn and inFlat

// ─────────────────────────── STATE ───────────────────────────
var array<bool>  stIn  = array.new<bool>(9, false)
var array<float> stEnt = array.new<float>(9, na)
var array<float> stStp = array.new<float>(9, na)
var array<bool>  st1   = array.new<bool>(9, false)
var array<float> stRem = array.new<float>(9, 0.0)
var array<float> stRe  = array.new<float>(9, 0.0)
var array<float> stMFE = array.new<float>(9, 0.0)
var array<int>   nTr   = array.new<int>(9, 0)
var array<int>   nHit  = array.new<int>(9, 0)
var array<int>   nHit2 = array.new<int>(9, 0)
var array<int>   nSl   = array.new<int>(9, 0)
var array<float> sumP  = array.new<float>(9, 0.0)
var array<float> sumM  = array.new<float>(9, 0.0)

// Sniper: Anchor, Ignition, Drift, Surge + Confluence track
// Scanner: adds Tide, Slipstream, Coil, Fracture
on = array.from(true, scanner, true, true, scanner, scanner, scanner, true, true)
ent = array.from(f_pick(a1B,a1S), f_pick(a2B,a2S), f_pick(a3B,a3S), f_pick(a4B,a4S), f_pick(a5B,a5S), f_pick(a6B,a6S), f_pick(a7B,a7S), f_pick(a8B,a8S), false)
exi = array.from(f_pick(x1B,x1S), f_pick(x2B,x2S), f_pick(x3B,x3S), f_pick(x4B,x4S), f_pick(x5B,x5S), f_pick(x6B,x6S), f_pick(x7B,x7S), f_pick(x8B,x8S), false)

var string exWhyHold = ""
string exWhy = ""
names = array.from("Anchor", "Tide", "Ignition", "Drift", "Slipstream", "Coil", "Fracture", "Surge", consN == 1 ? "Any engine" : "Two agree")

if barstate.isconfirmed
    for i = 0 to 8
        if i == 8
            ac = 0
            for j = 0 to 7
                if array.get(on, j) and array.get(stIn, j)
                    ac := ac + 1
            array.set(ent, 8, ac >= consN)
            array.set(exi, 8, ac == 0)

        if array.get(stIn, i)
            e  = array.get(stEnt, i)
            sp = array.get(stStp, i)
            rm = array.get(stRem, i)
            rl = array.get(stRe, i)
            array.set(stMFE, i, math.max(array.get(stMFE, i), high - e))
            bool  out = false
            float opx = na
            bool  wasSl = false

            if low <= sp
                out := true
                opx := sp
                wasSl := true
                if i == dIdx
                    exWhy := "SL"
            else
                if not array.get(st1, i) and high >= e + tp1p
                    array.set(st1, i, true)
                    rl := rl + 0.5 * tp1p
                    rm := rm - 0.5
                    sp := e
                if high >= e + tp2p
                    rl := rl + rm * tp2p
                    rm := 0.0
                    out := true
                    opx := e + tp2p
                    if i == dIdx
                        exWhy := "T2"
                if not out and (array.get(exi, i) or flatNow)
                    out := true
                    opx := close
                    if i == dIdx
                        exWhy := flatNow ? "EOD" : "EXIT"

            if out
                if rm > 0
                    rl := rl + rm * (opx - e)
                m = array.get(stMFE, i)
                array.set(nTr, i, array.get(nTr, i) + 1)
                array.set(sumP, i, array.get(sumP, i) + rl)
                array.set(sumM, i, array.get(sumM, i) + m)
                if m >= tp1p
                    array.set(nHit, i, array.get(nHit, i) + 1)
                if m >= tp2p
                    array.set(nHit2, i, array.get(nHit2, i) + 1)
                if wasSl and not array.get(st1, i)
                    array.set(nSl, i, array.get(nSl, i) + 1)
                array.set(stIn, i, false)
                array.set(stEnt, i, na)
                array.set(stStp, i, na)
                array.set(st1, i, false)
                array.set(stRem, i, 0.0)
                array.set(stRe, i, 0.0)
                array.set(stMFE, i, 0.0)
            else
                array.set(stStp, i, sp)
                array.set(stRem, i, rm)
                array.set(stRe, i, rl)
        else
            if array.get(on, i) and array.get(ent, i) and allow and not flatNow and close > 0
                array.set(stIn, i, true)
                array.set(stEnt, i, close)
                array.set(stStp, i, close - slp)
                array.set(st1, i, false)
                array.set(stRem, i, 1.0)
                array.set(stRe, i, 0.0)
                array.set(stMFE, i, 0.0)

dIn   = array.get(stIn, dIdx)
dPart = array.get(st1, dIdx)
dEnt  = array.get(stEnt, dIdx)
dStp  = array.get(stStp, dIdx)
dEntPrev = nz(dEnt[1], dEnt)
dStpPrev = nz(dStp[1], dStp)
if exWhy != ""
    exWhyHold := exWhy
justIn  = dIn and not dIn[1]
justOut = not dIn and dIn[1]
hit1 = dIn and dPart and not dPart[1]

// ─────────────────────────── VISUALS ───────────────────────────
cG  = color.new(#00c853, 0)
cGp = color.new(#00c853, 55)
cR  = color.new(#ff1744, 0)
barcolor(paint ? (dIn ? (dPart ? cGp : cG) : cR) : na, title = "Strike Rate")

rawFiring = (array.get(on,0) and array.get(ent,0)) or (array.get(on,1) and array.get(ent,1)) or (array.get(on,2) and array.get(ent,2)) or (array.get(on,3) and array.get(ent,3)) or (array.get(on,4) and array.get(ent,4)) or (array.get(on,5) and array.get(ent,5)) or (array.get(on,6) and array.get(ent,6)) or (array.get(on,7) and array.get(ent,7))
earlyDot = showEarly and rawFiring and not dIn and allow and not flatNow
plotshape(earlyDot, title = "Early warning", style = shape.circle, location = location.belowbar, color = color.new(#fbbf24, 20), size = size.tiny)

if showLbl and justIn
    label.new(bar_index, low, showPx ? "BUY " + str.tostring(dEnt, "#.##") : "BUY", yloc = yloc.belowbar, style = label.style_label_up, color = cG, textcolor = color.white, size = size.small)

if showLbl and hit1
    label.new(bar_index, dEnt + tp1p, "T1 hit  " + str.tostring(dEnt + tp1p, "#.##"), yloc = yloc.price, style = label.style_label_down, color = #fbbf24, textcolor = color.black, size = size.tiny)

if showLbl and justOut
    exTxt = exWhyHold == "T2" ? "T2 hit  " + str.tostring(dEntPrev + tp2p, "#.##") : exWhyHold == "SL" ? "STOP  " + str.tostring(dStpPrev, "#.##") : exWhyHold == "EOD" ? "EOD  " + str.tostring(close, "#.##") : "EXIT  " + str.tostring(close, "#.##")
    exCol = exWhyHold == "T2" ? #22d3ee : exWhyHold == "SL" ? cR : color.new(#94a3b8, 0)
    exTc  = exWhyHold == "T2" or exWhyHold == "SL" ? color.white : color.black
    label.new(bar_index, high, exTxt, yloc = yloc.abovebar, style = label.style_label_down, color = exCol, textcolor = exTc, size = size.small)

var box zT1 = na
var box zT2 = na
var box zSL = na
if showZone and justIn
    zT1 := box.new(bar_index, dEnt + tp1p, bar_index, dEnt, border_color = color.new(#00e676, 25), border_width = 1, bgcolor = color.new(#00e676, 72))
    zT2 := box.new(bar_index, dEnt + tp2p, bar_index, dEnt + tp1p, border_color = color.new(#00e676, 45), border_width = 1, bgcolor = color.new(#00e676, 84))
    zSL := box.new(bar_index, dEnt, bar_index, dEnt - slp, border_color = color.new(#ff5252, 25), border_width = 1, bgcolor = color.new(#ff5252, 72))
if showZone and dIn and not na(zT1)
    box.set_right(zT1, bar_index + 1)
    box.set_right(zT2, bar_index + 1)
    box.set_right(zSL, bar_index + 1)

plot(dIn ? dEnt : na, "Entry", color = color.new(color.white, 30), style = plot.style_linebr)
plot(dIn ? dEnt + tp1p : na, "Target 1", color = color.new(#00e676, 0), style = plot.style_linebr)
plot(dIn ? dEnt + tp2p : na, "Target 2", color = color.new(#00e676, 45), style = plot.style_linebr)
plot(dIn ? dStp : na, "Stop", color = color.new(#ff5252, 0), style = plot.style_linebr)

// ─────────────────────────── DASHBOARD ───────────────────────────
f_pos(s) => s == "Top left" ? position.top_left : s == "Bottom right" ? position.bottom_right : s == "Bottom left" ? position.bottom_left : position.top_right
f_sz(s) => s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

var table tb = table.new(f_pos(tblPos), 8, 12, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 55))

if showTbl and barstate.islast
    hb = color.new(#101826, 0)
    tw = color.new(color.white, 0)
    sz = f_sz(tblSize)
    table.cell(tb, 0, 0, "STRIKE RATE", bgcolor = hb, text_color = tw, text_size = sz, text_halign = text.align_left)
    table.cell(tb, 1, 0, "Trades", bgcolor = hb, text_color = tw, text_size = sz)
    table.cell(tb, 2, 0, "T1%",   bgcolor = hb, text_color = tw, text_size = sz)
    table.cell(tb, 3, 0, "T2%",   bgcolor = hb, text_color = tw, text_size = sz)
    table.cell(tb, 4, 0, "Avg",   bgcolor = hb, text_color = tw, text_size = sz)
    table.cell(tb, 5, 0, "Best",  bgcolor = hb, text_color = tw, text_size = sz)
    table.cell(tb, 6, 0, "Total", bgcolor = hb, text_color = tw, text_size = sz)
    table.cell(tb, 7, 0, "Now",   bgcolor = hb, text_color = tw, text_size = sz)

    r = 1
    for i = 0 to 8
        if array.get(on, i)
            n   = array.get(nTr, i)
            tot = array.get(sumP, i)
            av  = n > 0 ? tot / n : 0.0
            hp  = n > 0 ? 100.0 * array.get(nHit, i) / n : 0.0
            h2  = n > 0 ? 100.0 * array.get(nHit2, i) / n : 0.0
            bm  = n > 0 ? array.get(sumM, i) / n : 0.0
            liv = array.get(stIn, i)
            bg  = i == 8 ? color.new(#1e3a5f, 15) : color.new(#0b1220, 25)
            tc  = i == 8 ? color.new(#93c5fd, 0) : color.new(color.white, 10)
            hc  = hp >= 55 ? #00e676 : hp >= 45 ? #fbbf24 : #ff8a80
            vc  = tot > 0 ? #00e676 : tot < 0 ? #ff5252 : color.gray
            table.cell(tb, 0, r, array.get(names, i), bgcolor = bg, text_color = tc, text_size = sz, text_halign = text.align_left)
            table.cell(tb, 1, r, str.tostring(n), bgcolor = bg, text_color = tc, text_size = sz)
            table.cell(tb, 2, r, n > 0 ? str.tostring(hp, "#") + "%" : "—", bgcolor = bg, text_color = hc, text_size = sz)
            table.cell(tb, 3, r, n > 0 ? str.tostring(h2, "#") + "%" : "—", bgcolor = bg, text_color = tc, text_size = sz)
            table.cell(tb, 4, r, str.tostring(av, "#.#"), bgcolor = bg, text_color = tc, text_size = sz)
            table.cell(tb, 5, r, str.tostring(bm, "#.#"), bgcolor = bg, text_color = tc, text_size = sz)
            table.cell(tb, 6, r, str.tostring(tot, "#.#"), bgcolor = bg, text_color = vc, text_size = sz)
            table.cell(tb, 7, r, liv ? "● LONG" : "—", bgcolor = bg, text_color = liv ? #00e676 : color.gray, text_size = sz)
            r := r + 1

    fb = color.new(#0b1220, 0)
    ftxt = (isCE ? "CALL" : "PUT") + "   ·   " + mode + "   ·   T1 " + str.tostring(tp1p, "#") + " / T2 " + str.tostring(tp2p, "#") + " / Stop " + str.tostring(slp, "#") + "   ·   half@T1 · runner@T2   ·   no slippage/brokerage"
    table.cell(tb, 0, r, ftxt, bgcolor = fb, text_color = color.new(color.white, 35), text_size = sz, text_halign = text.align_left)
    for c = 1 to 7
        table.cell(tb, c, r, "", bgcolor = fb, text_size = sz)
    table.merge_cells(tb, 0, r, 7, r)

// ─────────────────────────── LIVE PANEL ───────────────────────────
var table pn = table.new(position.middle_left, 2, 6, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 45))
if showPnl and barstate.islast
    sz2 = f_sz(tblSize)
    mv  = dIn and not na(dEnt) ? close - dEnt : na
    mp  = dIn and not na(dEnt) and dEnt > 0 ? (close - dEnt) / dEnt * 100 : na
    good = not na(mv) and mv >= 0
    vb = not dIn ? color.new(#374151, 25) : good ? color.new(#065f46, 12) : color.new(#7f1d1d, 12)
    vt = not dIn ? color.new(color.white, 35) : good ? #6ee7b7 : #fca5a5
    lb = color.new(#101826, 0)
    lt = color.new(color.white, 30)
    table.cell(pn, 0, 0, "STRIKE RATE", bgcolor = lb, text_color = color.white, text_size = sz2, text_halign = text.align_left)
    table.cell(pn, 1, 0, side == "Auto" ? (isCE ? "CALL" : "PUT") : side, bgcolor = lb, text_color = color.new(color.white, 25), text_size = sz2)
    table.cell(pn, 0, 1, "Status", bgcolor = lb, text_color = lt, text_size = sz2, text_halign = text.align_left)
    table.cell(pn, 1, 1, dIn ? "IN TRADE" : "FLAT", bgcolor = vb, text_color = vt, text_size = sz2)
    table.cell(pn, 0, 2, "Entry", bgcolor = lb, text_color = lt, text_size = sz2, text_halign = text.align_left)
    table.cell(pn, 1, 2, dIn ? str.tostring(dEnt, "#.##") : "—", bgcolor = vb, text_color = vt, text_size = sz2)
    table.cell(pn, 0, 3, "Move", bgcolor = lb, text_color = lt, text_size = sz2, text_halign = text.align_left)
    table.cell(pn, 1, 3, na(mv) ? "—" : (mv >= 0 ? "+" : "") + str.tostring(mv, "#.##") + "  (" + str.tostring(mp, "#.#") + "%)", bgcolor = vb, text_color = vt, text_size = sz2)
    table.cell(pn, 0, 4, "Targets", bgcolor = lb, text_color = lt, text_size = sz2, text_halign = text.align_left)
    table.cell(pn, 1, 4, dIn ? (dPart ? "T1 ✓  T2 ·" : "T1 ·  T2 ·") : "—", bgcolor = vb, text_color = vt, text_size = sz2)
    table.cell(pn, 0, 5, "Stop", bgcolor = lb, text_color = lt, text_size = sz2, text_halign = text.align_left)
    table.cell(pn, 1, 5, dIn ? str.tostring(dStp, "#.##") : "—", bgcolor = vb, text_color = vt, text_size = sz2)

// ─────────────────────────── ALERTS ───────────────────────────
alertcondition(justIn,  "Strike Rate — BUY",  "STRIKE RATE buy {{ticker}} at {{close}}")
alertcondition(hit1,    "Strike Rate — T1",   "STRIKE RATE target 1 hit {{ticker}}")
alertcondition(justOut, "Strike Rate — EXIT", "STRIKE RATE exit {{ticker}} at {{close}}")
if justIn
    alert("STRIKE RATE buy " + syminfo.ticker + " at " + str.tostring(close, "#.##") + "  ·  T1 " + str.tostring(close + tp1p, "#.##") + "  ·  stop " + str.tostring(close - slp, "#.##"), alert.freq_once_per_bar_close)
if justOut
    alert("STRIKE RATE exit " + syminfo.ticker + " at " + str.tostring(close, "#.##"), alert.freq_once_per_bar_close)
