//@version=6
// ============================================================================
//  OPTIONS SCALPER 1-MIN  —  Nifty / BankNifty / Sensex option premium charts
// ----------------------------------------------------------------------------
//  Built for the OPTION chart itself (Call or Put), not the index.
//  Support/resistance for SIGNALS still use swings, fibs, ORB, day levels,
//  open/prev close and round numbers under the hood.
//
//  DRAWN ON CHART (only what you need to follow):
//     - Opening range high / low
//     - Day open, day high, day low
//     - Live trade: Entry, Stop, T1 / T2 / T3
//  Everything else (swings, fibs, rounds, prev close) stays hidden.
//
//  EMA 9/21, session VWAP, ATR and volume all run HIDDEN.
//  GREEN = long / buy this option. RED = breakdown / opposite contract cue.
// ============================================================================

indicator("Options Scalper 1-min", shorttitle = "OPT-1M", overlay = true,
     max_lines_count = 100, max_labels_count = 200)

max_bars_back(time, 500)

// ============================================================================
//  INPUTS
// ============================================================================
G0 = "1 - Trade"
slPct   = input.float(7.0,  "Stop loss pct of premium", minval = 5.0, maxval = 10.0, step = 0.5, group = G0)
t1Pct   = input.float(5.0,  "Target 1 pct",  minval = 2.0,  step = 0.5, group = G0)
t2Pct   = input.float(10.0, "Target 2 pct",  minval = 5.0,  step = 0.5, group = G0)
t3Pct   = input.float(20.0, "Target 3 pct",  minval = 10.0, step = 1.0, group = G0)
trailM  = input.float(2.5,  "Jackpot trail x ATR past Target 3", minval = 1.0, maxval = 5.0, step = 0.25, group = G0)
minPrem = input.float(10.0, "Minimum premium to trade", minval = 0.0, group = G0)

G1 = "2 - Filters (all hidden)"
trendMode = input.string("EMA only", "Trend filter", options = ["EMA + VWAP strict", "EMA only", "Off"], group = G1)
swM      = input.float(0.25, "Sideways when EMAs closer than x ATR", minval = 0.05, maxval = 1.0, step = 0.05, group = G1)
volM     = input.float(1.3, "Breakout needs volume x 20-bar average", minval = 1.0, maxval = 4.0, step = 0.1, group = G1)
skipOpen = input.int(3, "Skip first N candles of the day", minval = 0, maxval = 15, group = G1)
maxDay   = input.int(6, "Max trades per day", minval = 1, maxval = 30, group = G1)
lossWait = input.int(5, "Wait after a LOSING exit candles", minval = 0, maxval = 30, group = G1)
minGrade = input.string("B and above", "Minimum setup grade", options = ["A only", "B and above", "Any"], group = G1)
expiryMode = input.bool(false, "Expiry day - stricter", group = G1)

G2 = "3 - Levels (engine)"
pivLen   = input.int(5, "Swing pivot strength bars each side", minval = 2, maxval = 15, group = G2)
maxKeep  = input.int(5, "Swing levels kept per side", minval = 2, maxval = 12, group = G2)
tolM     = input.float(0.25, "Level touch tolerance x ATR", minval = 0.05, maxval = 1.0, step = 0.05, group = G2)
brkLen   = input.int(15, "Breakout lookback bars", minval = 5, maxval = 60, group = G2)
orbMins  = input.int(15, "Opening range minutes", minval = 1, maxval = 60, group = G2)
rndAuto  = input.bool(true, "Round numbers: automatic step", group = G2)
rndStep  = input.float(25.0, "Round number step manual", minval = 1.0, group = G2)
lvlSrc   = input.string("Swing + Fib", "Trigger levels come from", options = ["Swing + Fib", "Fib only", "Swing only"], group = G2)

G3 = "4 - Display"
showLvls  = input.bool(true, "Draw key levels ORB + day OHLC", group = G3)
paintBars = input.bool(true, "Paint candles green red orange", group = G3)
detail    = input.bool(false, "Detailed signal labels", group = G3)
showHits  = input.bool(false, "Mark T1 / T2 touches", group = G3)
dbgOn     = input.bool(true, "Mark blocked signals", group = G3)
keepTr    = input.int(12, "Trades kept on chart", minval = 1, maxval = 60, group = G3)
showLbls   = input.bool(true, "Level name labels", group = G3)
lblOff    = input.int(4, "Label offset bars", minval = 1, maxval = 20, group = G3)
showDash  = input.bool(true, "Dashboard", group = G3)
dashPos   = input.string("Bottom right", "Dashboard position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = G3)

C_UP  = #26a69a
C_DN  = #ef5350
C_WRN = #FF9800

// ============================================================================
//  SESSION CLOCK
// ============================================================================
istMin  = hour(time, "Asia/Kolkata") * 60 + minute(time, "Asia/Kolkata")
newDay  = ta.change(time("D")) != 0
lastEntryMin = expiryMode ? 14 * 60 + 30 : 15 * 60
hardExitMin  = 15 * 60 + 15

var int dayBar = 0
if newDay
    dayBar := 0
dayBar += 1

tfMin   = math.max(timeframe.in_seconds(timeframe.period) / 60.0, 1.0)
orbNeed = math.max(math.ceil(orbMins / tfMin), 1)
wrongTF = timeframe.period != "1"

// ============================================================================
//  HIDDEN ENGINE
// ============================================================================
e9    = ta.ema(close, 9)
e21   = ta.ema(close, 21)
atr14 = ta.atr(14)
rng   = high - low
body  = math.abs(close - open)
bodyR = rng > 0 ? body / rng : 0.0
loWick = math.min(open, close) - low
hiWick = high - math.max(open, close)

hasVol = not na(volume) and volume > 0
avgVol = ta.sma(nz(volume), 20)
volOK  = not hasVol or nz(volume) >= avgVol * volM

var float cumPV = 0.0
var float cumV  = 0.0
if newDay
    cumPV := 0.0
    cumV  := 0.0
wgt = hasVol ? nz(volume, 1.0) : 1.0
cumPV += hlc3 * wgt
cumV  += wgt
sVWAP = cumV > 0 ? cumPV / cumV : hlc3

trendUp  = trendMode == "Off" ? true : trendMode == "EMA only" ? e9 > e21 : e9 > e21 and close > sVWAP
trendDn  = trendMode == "Off" ? true : trendMode == "EMA only" ? e9 < e21 : e9 < e21 and close < sVWAP
sideways = math.abs(e9 - e21) <= atr14 * swM

// ============================================================================
//  SESSION LEVELS (engine — most stay undrawn)
// ============================================================================
var float dOpen    = na
var float pdc      = na
var float dayHi    = na
var float dayLo    = na
var int   dayHiBar = 0
var int   dayLoBar = 0
var int   dStart   = 0

if newDay
    pdc      := close[1]
    dOpen    := open
    dayHi    := high
    dayLo    := low
    dayHiBar := bar_index
    dayLoBar := bar_index
    dStart   := bar_index
else
    if high > dayHi
        dayHi    := high
        dayHiBar := bar_index
    if low < dayLo
        dayLo    := low
        dayLoBar := bar_index

var float orH    = na
var float orL    = na
var int   orBars = 0
if newDay
    orH    := na
    orL    := na
    orBars := 0
if orBars < orbNeed
    orH    := na(orH) ? high : math.max(orH, high)
    orL    := na(orL) ? low  : math.min(orL, low)
    orBars += 1
orDone = not na(orH) and orBars >= orbNeed

rStep    = rndAuto ? (close < 100 ? 5.0 : close < 500 ? 25.0 : 50.0) : rndStep
rndBelow = math.floor(close / rStep) * rStep
rndAbove = rndBelow + rStep

var array<float> resP = array.new<float>()
var array<float> supP = array.new<float>()
if newDay
    array.clear(resP)
    array.clear(supP)

phv = ta.pivothigh(high, pivLen, pivLen)
plv = ta.pivotlow(low, pivLen, pivLen)
if not na(phv)
    array.push(resP, phv)
    if array.size(resP) > maxKeep
        array.shift(resP)
if not na(plv)
    array.push(supP, plv)
    if array.size(supP) > maxKeep
        array.shift(supP)

fRange  = dayHi - dayLo
fibOK   = not na(dayHi) and not na(dayLo) and fRange > atr14 * 2.0
f382 = fibOK ? dayHi - 0.382 * fRange : na
f500 = fibOK ? dayHi - 0.500 * fRange : na
f618 = fibOK ? dayHi - 0.618 * fRange : na
fxU1 = fibOK ? dayHi + 0.272 * fRange : na
fxU2 = fibOK ? dayHi + 0.618 * fRange : na
fxU3 = fibOK ? dayHi + 1.000 * fRange : na
fxU4 = fibOK ? dayHi + 1.618 * fRange : na
fxD1 = fibOK ? dayLo - 0.272 * fRange : na
fxD2 = fibOK ? dayLo - 0.618 * fRange : na
fxD3 = fibOK ? dayLo - 1.000 * fRange : na
fxD4 = fibOK ? dayLo - 1.618 * fRange : na
useSwingT = lvlSrc != "Fib only"
useFibT   = lvlSrc != "Swing only"

var array<float> lvls = array.new<float>()
array.clear(lvls)
if useSwingT and array.size(supP) > 0
    for i = 0 to array.size(supP) - 1
        array.push(lvls, array.get(supP, i))
if useSwingT and array.size(resP) > 0
    for i = 0 to array.size(resP) - 1
        array.push(lvls, array.get(resP, i))
if not na(dOpen)
    array.push(lvls, dOpen)
if not na(pdc)
    array.push(lvls, pdc)
if not na(dayHi) and bar_index - dayHiBar >= 3
    array.push(lvls, dayHi)
if not na(dayLo) and bar_index - dayLoBar >= 3
    array.push(lvls, dayLo)
if orDone
    array.push(lvls, orH)
    array.push(lvls, orL)
if useFibT and not na(f382)
    array.push(lvls, f382)
if useFibT and not na(f500)
    array.push(lvls, f500)
if useFibT and not na(f618)
    array.push(lvls, f618)
if useFibT and not na(fxU1)
    array.push(lvls, fxU1)
if useFibT and not na(fxU2)
    array.push(lvls, fxU2)
if useFibT and not na(fxD1)
    array.push(lvls, fxD1)
if useFibT and not na(fxD2)
    array.push(lvls, fxD2)
if useFibT and not na(fxU3)
    array.push(lvls, fxU3)
if useFibT and not na(fxU4)
    array.push(lvls, fxU4)
if useFibT and not na(fxD3)
    array.push(lvls, fxD3)
if useFibT and not na(fxD4)
    array.push(lvls, fxD4)

// ============================================================================
//  TRIGGERS
// ============================================================================
tol = atr14 * tolM

bool bounceL = false
bool rejectS = false
if array.size(lvls) > 0
    for i = 0 to array.size(lvls) - 1
        lvl = array.get(lvls, i)
        if not na(lvl)
            if low <= lvl + tol and low >= lvl - tol * 2 and close > lvl and close > open and loWick >= rng * 0.2
                bounceL := true
            if high >= lvl - tol and high <= lvl + tol * 2 and close < lvl and close < open and hiWick >= rng * 0.2
                rejectS := true

brkL = close > ta.highest(high, brkLen)[1] and bodyR >= 0.5 and volOK
brkS = close < ta.lowest(low, brkLen)[1]  and bodyR >= 0.5 and volOK
pbL = useFibT and fibOK and low  <= f382 + tol and low  >= f618 - tol and close > open and loWick >= rng * 0.2
pbS = useFibT and fibOK and high >= f618 - tol and high <= f382 + tol and close < open and hiWick >= rng * 0.2

cfL = (bounceL ? 1 : 0) + (brkL ? 1 : 0) + (pbL ? 1 : 0) + (hasVol and nz(volume) >= avgVol * volM ? 1 : 0) + (loWick >= rng * 0.3 ? 1 : 0)
cfS = (rejectS ? 1 : 0) + (brkS ? 1 : 0) + (pbS ? 1 : 0) + (hasVol and nz(volume) >= avgVol * volM ? 1 : 0) + (hiWick >= rng * 0.3 ? 1 : 0)

// ============================================================================
//  POSITION
// ============================================================================
var int   pos     = 0
var float ent     = na
var float slPx    = na
var float risk    = na
var float tg1     = na
var float tg2     = na
var float tg3     = na
var bool  h1      = false
var bool  h2      = false
var bool  h3      = false
var int   entBar  = -1
var int   exitBar = -1
var int   waitTill  = -1
var int   dayTrades = 0
var array<label> trLbls = array.new<label>()

var int   trades = 0
var int   wins   = 0
var int   bes    = 0
var int   losses = 0
var float totR   = 0.0
var float dayR   = 0.0
if newDay
    dayR := 0.0
    dayTrades := 0

bookR(float px) =>
    (px - ent) * pos / risk

float exR = na
if pos != 0 and barstate.isconfirmed and bar_index > entBar
    bool stopped  = pos == 1 ? low <= slPx : high >= slPx
    bool timeOut  = istMin >= hardExitMin
    if stopped
        exR := bookR(slPx)
    else
        if not h1 and (pos == 1 ? high >= tg1 : low <= tg1)
            h1   := true
            slPx := pos == 1 ? math.max(slPx, ent) : math.min(slPx, ent)
            if showHits
                array.push(trLbls, label.new(bar_index, pos == 1 ? high : low, "T1", style = pos == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny))
        if not h2 and (pos == 1 ? high >= tg2 : low <= tg2)
            h2   := true
            slPx := pos == 1 ? math.max(slPx, tg1) : math.min(slPx, tg1)
            if showHits
                array.push(trLbls, label.new(bar_index, pos == 1 ? high : low, "T2", style = pos == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny))
        if not h3 and (pos == 1 ? high >= tg3 : low <= tg3)
            h3 := true
            array.push(trLbls, label.new(bar_index, pos == 1 ? high : low, "T3", style = pos == 1 ? label.style_label_down : label.style_label_up, color = color.new(C_WRN, 0), textcolor = color.black, size = size.tiny))
        if h3
            slPx := pos == 1 ? math.max(slPx, close - atr14 * trailM) : math.min(slPx, close + atr14 * trailM)
        if timeOut
            exR := bookR(close)

if not na(exR)
    trades += 1
    if exR > 0.05
        wins += 1
    else if exR >= -0.05
        bes += 1
    else
        losses += 1
    totR += exR
    dayR += exR
    exitTxt = (detail ? "EXIT  " : "") + (exR >= 0 ? "+" : "") + str.tostring(exR, "#.##") + "R"
    exitCol = pos == 1 ? C_UP : C_DN
    array.push(trLbls, label.new(bar_index, pos == 1 ? high : low, exitTxt, style = pos == 1 ? label.style_label_down : label.style_label_up, color = color.new(exitCol, detail ? 0 : 35), textcolor = color.white, size = detail ? size.small : size.tiny))
    if exR < -0.05
        waitTill := bar_index + lossWait
    pos     := 0
    exitBar := bar_index
    h1 := false
    h2 := false
    h3 := false

inWindow = dayBar > skipOpen and istMin < lastEntryMin and istMin >= 9 * 60 + 15
lowPrem  = close < minPrem
minCf = minGrade == "A only" ? 3 : minGrade == "B and above" ? 2 : 1
gradeOK_L = cfL >= minCf and (not expiryMode or cfL >= 2)
gradeOK_S = cfS >= minCf and (not expiryMode or cfS >= 2)

longSig  = bounceL or brkL or pbL
shortSig = rejectS or brkS or pbS

capOK   = dayTrades < maxDay
coolOK  = bar_index > waitTill
canL = barstate.isconfirmed and pos == 0 and bar_index > exitBar and coolOK and capOK and inWindow and not lowPrem and not sideways and trendUp and longSig and gradeOK_L
canS = barstate.isconfirmed and pos == 0 and bar_index > exitBar and coolOK and capOK and inWindow and not lowPrem and not sideways and trendDn and shortSig and gradeOK_S and not canL

if canL or canS
    pos    := canL ? 1 : -1
    ent    := close
    risk   := ent * slPct / 100.0
    slPx   := canL ? ent - risk : ent + risk
    tg1    := canL ? ent * (1 + t1Pct / 100.0) : ent * (1 - t1Pct / 100.0)
    tg2    := canL ? ent * (1 + t2Pct / 100.0) : ent * (1 - t2Pct / 100.0)
    tg3    := canL ? ent * (1 + t3Pct / 100.0) : ent * (1 - t3Pct / 100.0)
    entBar := bar_index
    cf     = canL ? cfL : cfS
    gr     = cf >= 3 ? "A" : cf == 2 ? "B" : "C"
    why    = canL ? (bounceL ? "bounce" : brkL ? "breakout" : "fib pullback") : (rejectS ? "reject" : brkS ? "breakdown" : "fib pullback")
    dayTrades += 1
    eTxt   = detail ? "ENTER " + gr + "\n" + why : "E-" + gr
    array.push(trLbls, label.new(bar_index, canL ? low : high, eTxt, style = canL ? label.style_label_up : label.style_label_down, color = color.new(canL ? C_UP : C_DN, detail ? 0 : 35), textcolor = color.white, size = detail ? size.small : size.tiny))
    while array.size(trLbls) > keepTr * 4
        label.delete(array.shift(trLbls))

// ============================================================================
//  WHY-NOT DIAGNOSTICS
// ============================================================================
var array<label> dbgLbls = array.new<label>()

blockTag(bool isLong) =>
    string r = "?"
    if wrongTF
        r := "1m only"
    else if not inWindow
        r := "time"
    else if not capOK
        r := "cap"
    else if bar_index <= exitBar
        r := "wait"
    else if not coolOK
        r := "cool"
    else if lowPrem
        r := "prem"
    else if sideways
        r := "side"
    else if isLong and not trendUp
        r := "trend"
    else if not isLong and not trendDn
        r := "trend"
    else if isLong and not gradeOK_L
        r := "grade"
    else if not isLong and not gradeOK_S
        r := "grade"
    r

if dbgOn and barstate.isconfirmed and pos == 0
    if longSig and not canL
        array.push(dbgLbls, label.new(bar_index, low, "x " + blockTag(true), style = label.style_label_up, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny))
    if shortSig and not canS and not canL
        array.push(dbgLbls, label.new(bar_index, high, "x " + blockTag(false), style = label.style_label_down, color = color.new(color.gray, 55), textcolor = color.white, size = size.tiny))
    while array.size(dbgLbls) > 40
        label.delete(array.shift(dbgLbls))

barcolor(paintBars ? (sideways ? C_WRN : trendUp and e9 > e21 ? C_UP : trendDn and e9 < e21 ? C_DN : na) : na)

// ============================================================================
//  DRAWING — ONLY key session levels + live trade lines
// ============================================================================
var array<line>  lnA  = array.new<line>()
var array<label> lblA = array.new<label>()

mkLv(float v, string txt, color c, int wdt, string sty, int fromBar) =>
    bool made = false
    if not na(v) and showLvls
        ls = sty == "dot" ? line.style_dotted : sty == "dash" ? line.style_dashed : line.style_solid
        array.push(lnA, line.new(math.max(fromBar, bar_index - 490), v, bar_index + lblOff, v, xloc = xloc.bar_index, color = c, width = wdt, style = ls))
        if showLbls
            array.push(lblA, label.new(bar_index + lblOff, v, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 85), textcolor = c, size = size.tiny))
        made := true
    made

if barstate.islast
    while array.size(lnA) > 0
        line.delete(array.pop(lnA))
    while array.size(lblA) > 0
        label.delete(array.pop(lblA))

    // Key levels only — no swings, fibs, rounds, or prev close on chart
    mkLv(dOpen, "Day open", #2962FF, 1, "solid", dStart)
    mkLv(dayHi, "Day high", #26a69a, 1, "solid", dStart)
    mkLv(dayLo, "Day low", #ef5350, 1, "solid", dStart)
    if orDone
        mkLv(orH, "ORB-H", #FFD600, 2, "solid", dStart)
        mkLv(orL, "ORB-L", #FF6D00, 2, "solid", dStart)

    // Live trade lines only while in a position
    if pos != 0
        pcol = pos == 1 ? C_UP : C_DN
        array.push(lnA, line.new(entBar, ent,  bar_index + lblOff, ent,  xloc = xloc.bar_index, color = pcol, width = 2))
        array.push(lnA, line.new(entBar, slPx, bar_index + lblOff, slPx, xloc = xloc.bar_index, color = color.red, width = 2, style = line.style_dashed))
        array.push(lnA, line.new(entBar, tg1,  bar_index + lblOff, tg1,  xloc = xloc.bar_index, color = color.new(pcol, 40), width = 1, style = line.style_dotted))
        array.push(lnA, line.new(entBar, tg2,  bar_index + lblOff, tg2,  xloc = xloc.bar_index, color = color.new(pcol, 40), width = 1, style = line.style_dotted))
        array.push(lnA, line.new(entBar, tg3,  bar_index + lblOff, tg3,  xloc = xloc.bar_index, color = color.new(C_WRN, 0), width = 1, style = line.style_dotted))
        array.push(lblA, label.new(bar_index + lblOff, ent,  "Entry " + str.tostring(ent, format.mintick), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(pcol, 85), textcolor = pcol, size = size.tiny))
        array.push(lblA, label.new(bar_index + lblOff, slPx, "SL " + str.tostring(slPx, format.mintick) + (h1 ? " locked" : ""), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.red, 85), textcolor = color.red, size = size.tiny))
        array.push(lblA, label.new(bar_index + lblOff, tg1,  "T1 " + str.tostring(t1Pct, "#") + "%", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(pcol, 85), textcolor = pcol, size = size.tiny))
        array.push(lblA, label.new(bar_index + lblOff, tg2,  "T2 " + str.tostring(t2Pct, "#") + "%", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(pcol, 85), textcolor = pcol, size = size.tiny))
        array.push(lblA, label.new(bar_index + lblOff, tg3,  "T3 " + str.tostring(t3Pct, "#") + "%", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(C_WRN, 85), textcolor = C_WRN, size = size.tiny))

// ============================================================================
//  DASHBOARD
// ============================================================================
dPos = dashPos == "Top right" ? position.top_right : dashPos == "Bottom left" ? position.bottom_left : dashPos == "Top left" ? position.top_left : position.bottom_right
var table dash = table.new(dPos, 2, 12, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60), bgcolor = color.new(color.black, 15))

row(int r, string a, string b, color c) =>
    table.cell(dash, 0, r, a, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, b, text_color = c, text_size = size.small, text_halign = text.align_right)

if showDash and barstate.islast
    pnlPct  = pos != 0 ? (close - ent) * pos / ent * 100.0 : na
    posTxt  = pos == 0 ? "flat" : (pos == 1 ? "LONG " : "SHORT ") + (pnlPct >= 0 ? "+" : "") + str.tostring(pnlPct, "#.##") + "%" + (h3 ? " · trailing" : h2 ? " · T2 hit" : h1 ? " · T1 hit" : "")
    blockTxt = pos != 0 ? "managing open trade" : wrongTF ? "use the 1-min chart" : not inWindow ? (dayBar <= skipOpen ? "skipping opening candles" : "entries closed for today") : lowPrem ? "premium under " + str.tostring(minPrem, "#") : not capOK ? "daily cap reached" : not coolOK ? "cooling off after a loss" : sideways ? "sideways - stand aside" : not trendUp and not trendDn ? "waiting for trend" : "waiting for a trigger"
    trTxt   = sideways ? "SIDEWAYS" : trendUp ? "UP - longs only" : trendDn ? "DOWN - shorts / opposite" : "mixed"
    trCol   = sideways ? C_WRN : trendUp ? C_UP : trendDn ? C_DN : color.silver
    volTxt  = not hasVol ? "no volume" : str.tostring(nz(volume) / math.max(avgVol, 1.0), "#.##") + " x avg"
    thetaTxt = istMin >= 14 * 60 + 30 ? (expiryMode ? "EXPIRY afternoon" : "late session") : ""

    row(0, "Position", posTxt, pos == 0 ? color.silver : pos == 1 ? C_UP : C_DN)
    row(1, "Status", blockTxt, color.white)
    row(2, "Trend", trTxt, trCol)
    row(3, "VWAP side", close > sVWAP ? "above" : "below", close > sVWAP ? C_UP : C_DN)
    row(4, "Volume", volTxt, hasVol and nz(volume) > avgVol * 1.5 ? C_WRN : color.white)
    row(5, "Day range", str.tostring(dayLo, format.mintick) + " - " + str.tostring(dayHi, format.mintick), color.white)
    row(6, "Trades", str.tostring(trades), color.white)
    row(7, "W / BE / L", str.tostring(wins) + " / " + str.tostring(bes) + " / " + str.tostring(losses), wins >= losses ? C_UP : C_DN)
    row(8, "Total R", (totR >= 0 ? "+" : "") + str.tostring(totR, "#.##") + "R", totR >= 0 ? C_UP : C_DN)
    row(9, "Avg R / trade", trades > 0 ? str.tostring(totR / trades, "#.##") + "R" : "-", trades > 0 and totR / math.max(trades, 1) >= 0.2 ? C_UP : C_WRN)
    row(10, "Today", (dayR >= 0 ? "+" : "") + str.tostring(dayR, "#.##") + "R", dayR >= 0 ? C_UP : C_DN)
    row(11, "Levels", lvlSrc + (expiryMode ? " · expiry ON" : "") + (thetaTxt == "" ? "" : " · " + thetaTxt), thetaTxt == "" ? color.silver : C_WRN)

alertcondition(canL, "Enter long", "OPT-1M: ENTER green - buy this option")
alertcondition(canS, "Enter short side", "OPT-1M: ENTER red - premium breaking down")
alertcondition(not na(exR), "Exit", "OPT-1M: EXIT - trade closed")
