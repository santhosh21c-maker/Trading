//@version=6
// Smart Robotic Logic - Decider and Targets (Educational recreation)
//
// LADDER (verified on vendor screenshots):
//   C = (H+L)/2 , B = (H-L)/2
//   Decider = C +/- 0.06*B     // gap = 0.12*B
//   Targets = C +/- {1, 1.54, 1.83, 2.08}*B
//
// EXTEND:
//   ONLY lengthens horizontal Decider/Target lines to the right.
//   It does NOT plot a future price path / predicted candles.
//   It does NOT change C/B for INDIAN or ROBOT (per latest vendor behaviour).
//
// ROBOT H/L:
//   Independent of Extend. Uses chart TF (1m).
//   PUT 24450: raw lastN Low matched vendor L=8.25; raw High=32.15 was wick vs vendor H≈18.15.
//   Default H source = Body high (ignore upper wicks). L source = Low.
//
indicator("Smart Robotic Logic - Decider and Targets", overlay = true, max_lines_count = 500, max_labels_count = 500, dynamic_requests = false)

grpRobot = "Robot Targets"
enableLevels = input.bool(true, "Enable Automated Levels", group = grpRobot)
segment = input.string("Robot Prediction", "Segment", options = ["INDIAN - Index, Stock & Option", "Robot Prediction"], group = grpRobot)
extendLen = input.int(50, "Extend (line length bars)", minval = 2, maxval = 500, group = grpRobot, tooltip = "Horizontal line length only. Does NOT change Decider/Targets. Does NOT plot future prices.")
anchorDate = input.time(timestamp("11 Aug 2026 00:00"), "Anchor Date", group = grpRobot)
hybrid5m = input.bool(true, "Hybrid Force 5 Min Values", group = grpRobot, tooltip = "INDIAN only.")

grpRobHL = "Robot H/L (not Extend)"
robotMode = input.string("Today after Start", "Robot Range", options = ["Today after Start", "Last N bars", "First N bars (session)", "Prior day"], group = grpRobHL, tooltip = "Extend does not feed this. Pick how H/L are taken.")
robotLookback = input.int(50, "Robot Lookback N", minval = 2, maxval = 500, group = grpRobHL, tooltip = "Used only for Last N / First N modes.")
robotStartHhmm = input.int(915, "Robot Start HHMM (IST)", minval = 915, maxval = 1500, group = grpRobHL)
robotHSource = input.string("Body high", "Robot H Source", options = ["High", "Body high", "Close"], group = grpRobHL, tooltip = "Vendor PUT H≈18.15 vs wick 32 → Body high or Close.")
robotLSource = input.string("Low", "Robot L Source", options = ["Low", "Body low", "Close"], group = grpRobHL, tooltip = "Vendor PUT L=8.25 matched raw Low.")

grpSnap = "Snapshot / Freeze"
forceRecalc = input.bool(false, "Force Recalculate Now", group = grpSnap)
extendRightManual = input.int(0, "Extra Extend Right (bars)", minval = 0, maxval = 500, group = grpSnap)
extendLeft = input.int(120, "Extend Lines Left (bars)", minval = 0, maxval = 500, group = grpSnap)

grpShow = "Show / Hide"
showDecider = input.bool(true, "Show Decider", group = grpShow)
showUpTgts = input.bool(true, "Show Upper Targets", group = grpShow)
showDnTgts = input.bool(true, "Show Lower Targets", group = grpShow)
showLabels = input.bool(true, "Show Labels", group = grpShow)
showCenter = input.bool(false, "Show Centre C", group = grpShow)

grpLadder = "Ladder (x Base B)"
deciderFrac = input.float(0.06, "Decider +/- x B", step = 0.001, group = grpLadder)
t1Ratio = input.float(1.00, "Target 1 x B", step = 0.01, group = grpLadder)
t2Ratio = input.float(1.54, "Target 2 x B", step = 0.01, group = grpLadder)
t3Ratio = input.float(1.83, "Target 3 x B", step = 0.01, group = grpLadder)
t4Ratio = input.float(2.08, "Target 4 x B", step = 0.01, group = grpLadder)

grpStyle = "Colors"
clrDecider = input.color(color.new(#9E9E9E, 0), "Decider", group = grpStyle)
clrT1 = input.color(color.new(#26A69A, 0), "Target 1", group = grpStyle)
clrT2 = input.color(color.new(#FF9800, 0), "Target 2", group = grpStyle)
clrT3 = input.color(color.new(#EC407A, 0), "Target 3", group = grpStyle)
clrT4 = input.color(color.new(#AB47BC, 0), "Target 4", group = grpStyle)
clrCenter = input.color(color.new(#787B86, 0), "Centre", group = grpStyle)
lineWidth = input.int(1, "Line Width", minval = 1, maxval = 3, group = grpStyle)

isIndian = segment == "INDIAN - Index, Stock & Option"
tz = "Asia/Kolkata"
extendRight = math.max(extendLen, extendRightManual)

f_hhmm(int idx) =>
    hour(time[idx], tz) * 100 + minute(time[idx], tz)

f_same_day(int idx, int d0, int m0, int y0) =>
    dayofmonth(time[idx], tz) == d0 and month(time[idx], tz) == m0 and year(time[idx], tz) == y0

f_pick_h(int idx, string src) =>
    src == "Close" ? close[idx] : src == "Body high" ? math.max(open[idx], close[idx]) : high[idx]

f_pick_l(int idx, string src) =>
    src == "Close" ? close[idx] : src == "Body low" ? math.min(open[idx], close[idx]) : low[idx]

f_prior_day_hl() =>
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    float h = na
    float l = na
    int maxScan = math.min(bar_index, 5000)
    bool inPrior = false
    int priorD = na
    int priorM = na
    int priorY = na
    for i = 1 to maxScan
        int di = dayofmonth(time[i], tz)
        int mi = month(time[i], tz)
        int yi = year(time[i], tz)
        bool sameAsToday = di == d0 and mi == m0 and yi == y0
        if not sameAsToday
            if not inPrior
                inPrior := true
                priorD := di
                priorM := mi
                priorY := yi
                h := high[i]
                l := low[i]
            else if di == priorD and mi == priorM and yi == priorY
                h := math.max(h, high[i])
                l := math.min(l, low[i])
            else
                break
    [h, l]

// Prior day with selectable H/L sources (for Robot prior-day mode)
f_prior_day_hl_src(string hSrc, string lSrc) =>
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    float h = na
    float l = na
    int maxScan = math.min(bar_index, 5000)
    bool inPrior = false
    int priorD = na
    int priorM = na
    int priorY = na
    int cnt = 0
    for i = 1 to maxScan
        int di = dayofmonth(time[i], tz)
        int mi = month(time[i], tz)
        int yi = year(time[i], tz)
        bool sameAsToday = di == d0 and mi == m0 and yi == y0
        if not sameAsToday
            if not inPrior
                inPrior := true
                priorD := di
                priorM := mi
                priorY := yi
                h := f_pick_h(i, hSrc)
                l := f_pick_l(i, lSrc)
                cnt := 1
            else if di == priorD and mi == priorM and yi == priorY
                h := math.max(h, f_pick_h(i, hSrc))
                l := math.min(l, f_pick_l(i, lSrc))
                cnt += 1
            else
                break
    [h, l, cnt]

[hDayOwn, lDayOwn] = f_prior_day_hl()
[hDay5, lDay5] = request.security(syminfo.tickerid, "5", f_prior_day_hl(), lookahead = barmerge.lookahead_off)

f_robot_hl(string mode, int len, int startHhmm, string hSrc, string lSrc) =>
    float h = na
    float l = na
    int cnt = 0
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    int maxScan = math.min(bar_index, 5000)

    if mode == "Prior day"
        [hp, lp, cp] = f_prior_day_hl_src(hSrc, lSrc)
        h := hp
        l := lp
        cnt := cp
    else if mode == "First N bars (session)"
        int dayBars = 0
        for i = 1 to maxScan
            if f_same_day(i, d0, m0, y0)
                dayBars += 1
            else
                break
        if dayBars > 0
            for i = dayBars to 1
                if f_hhmm(i) >= startHhmm
                    float bh = f_pick_h(i, hSrc)
                    float bl = f_pick_l(i, lSrc)
                    h := na(h) ? bh : math.max(h, bh)
                    l := na(l) ? bl : math.min(l, bl)
                    cnt += 1
                    if cnt >= len
                        break
    else if mode == "Last N bars"
        for i = 1 to maxScan
            if cnt >= len
                break
            if f_same_day(i, d0, m0, y0) and f_hhmm(i) >= startHhmm
                float bh = f_pick_h(i, hSrc)
                float bl = f_pick_l(i, lSrc)
                h := na(h) ? bh : math.max(h, bh)
                l := na(l) ? bl : math.min(l, bl)
                cnt += 1
            else if not f_same_day(i, d0, m0, y0)
                break
    else
        // Today after Start — ALL today bars after HHMM (Extend/N ignored)
        for i = 1 to maxScan
            if f_same_day(i, d0, m0, y0)
                if f_hhmm(i) >= startHhmm
                    float bh = f_pick_h(i, hSrc)
                    float bl = f_pick_l(i, lSrc)
                    h := na(h) ? bh : math.max(h, bh)
                    l := na(l) ? bl : math.min(l, bl)
                    cnt += 1
            else
                break
    [h, l, cnt]

[hRob, lRob, nRob] = f_robot_hl(robotMode, robotLookback, robotStartHhmm, robotHSource, robotLSource)

rawH = isIndian ? (hybrid5m ? hDay5 : hDayOwn) : hRob
rawL = isIndian ? (hybrid5m ? lDay5 : lDayOwn) : lRob
srcTxt = isIndian ? "INDIAN prior-day | Extend=lines only" : ("ROBOT " + robotMode + " | H=" + robotHSource + " L=" + robotLSource + " >=" + str.tostring(robotStartHhmm) + " n=" + str.tostring(nRob) + " | Extend=lines only")

liveC = (rawH + rawL) / 2.0
liveB = (rawH - rawL) / 2.0

var float frozenC = na
var float frozenB = na
var float frozenH = na
var float frozenL = na
var int frozenExt = -1
var string frozenSeg = "INIT"
var int frozenDate = -1
var int frozenHyb = -1
var int frozenForce = -1
var int frozenStart = -1
var int frozenCnt = -1
var int frozenLB = -1
var string frozenMode = "INIT"
var string frozenHS = "INIT"
var string frozenLS = "INIT"

hybFlag = hybrid5m ? 1 : 0
forceFlag = forceRecalc ? 1 : 0
// Extend changes do NOT invalidate C/B snapshot (visual only) — still track for line redraw
inputsChanged = segment != frozenSeg or anchorDate != frozenDate or hybFlag != frozenHyb or forceFlag != frozenForce or robotStartHhmm != frozenStart or robotMode != frozenMode or robotLookback != frozenLB or robotHSource != frozenHS or robotLSource != frozenLS
canSnap = enableLevels and barstate.islast and not na(liveC) and not na(liveB) and liveB > 0
shouldSnapshot = canSnap and (inputsChanged or na(frozenC))

if shouldSnapshot
    frozenC := liveC
    frozenB := liveB
    frozenH := rawH
    frozenL := rawL
    frozenExt := extendLen
    frozenSeg := segment
    frozenDate := anchorDate
    frozenHyb := hybFlag
    frozenForce := forceFlag
    frozenStart := robotStartHhmm
    frozenCnt := nRob
    frozenLB := robotLookback
    frozenMode := robotMode
    frozenHS := robotHSource
    frozenLS := robotLSource

C = frozenC
B = frozenB
decHi = C + deciderFrac * B
decLo = C - deciderFrac * B
upT1 = C + t1Ratio * B
upT2 = C + t2Ratio * B
upT3 = C + t3Ratio * B
upT4 = C + t4Ratio * B
dnT1 = C - t1Ratio * B
dnT2 = C - t2Ratio * B
dnT3 = C - t3Ratio * B
dnT4 = C - t4Ratio * B

var line[] lines = array.new_line()
var label[] labels = array.new_label()

f_clear() =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

f_level(float price, string txt, color lineCol, bool showLine) =>
    if not na(price) and showLine
        int x1 = bar_index - extendLeft
        int x2 = bar_index + extendRight
        line ln = line.new(x1, price, x2, price, xloc = xloc.bar_index, extend = extend.none, color = lineCol, style = line.style_dashed, width = lineWidth)
        array.push(lines, ln)
        if showLabels
            label lb = label.new(x2, price, txt + " / " + str.tostring(price, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(lineCol, 85), textcolor = lineCol, size = size.small)
            array.push(labels, lb)

if barstate.islast and enableLevels and not na(C) and not na(B) and B > 0
    f_clear()
    if showDecider
        f_level(decHi, "Decider", clrDecider, true)
        f_level(decLo, "Decider", clrDecider, true)
    if showCenter
        f_level(C, "Centre", clrCenter, true)
    if showUpTgts
        f_level(upT1, "Target 1", clrT1, true)
        f_level(upT2, "Target 2", clrT2, true)
        f_level(upT3, "Target 3", clrT3, true)
        f_level(upT4, "Target 4", clrT4, true)
    if showDnTgts
        f_level(dnT1, "Target 1", clrT1, true)
        f_level(dnT2, "Target 2", clrT2, true)
        f_level(dnT3, "Target 3", clrT3, true)
        f_level(dnT4, "Target 4", clrT4, true)

bgcolor(color.new(color.black, 100))
plot(close, title = "seed", display = display.none)
plot(enableLevels ? frozenH : na, "Window High", display = display.data_window)
plot(enableLevels ? frozenL : na, "Window Low", display = display.data_window)
plot(enableLevels ? C : na, "Centre C", color = clrCenter, display = display.data_window)
plot(enableLevels ? B : na, "Base B", color = clrCenter, display = display.data_window)
plot(enableLevels and showDecider ? decHi : na, "Decider High", color = clrDecider, display = display.data_window)
plot(enableLevels and showDecider ? decLo : na, "Decider Low", color = clrDecider, display = display.data_window)
plot(enableLevels and showUpTgts ? upT1 : na, "Up T1", color = clrT1, display = display.data_window)
plot(enableLevels and showUpTgts ? upT2 : na, "Up T2", color = clrT2, display = display.data_window)
plot(enableLevels and showUpTgts ? upT3 : na, "Up T3", color = clrT3, display = display.data_window)
plot(enableLevels and showUpTgts ? upT4 : na, "Up T4", color = clrT4, display = display.data_window)
plot(enableLevels and showDnTgts ? dnT1 : na, "Dn T1", color = clrT1, display = display.data_window)
plot(enableLevels and showDnTgts ? dnT2 : na, "Dn T2", color = clrT2, display = display.data_window)
plot(enableLevels and showDnTgts ? dnT3 : na, "Dn T3", color = clrT3, display = display.data_window)
plot(enableLevels and showDnTgts ? dnT4 : na, "Dn T4", color = clrT4, display = display.data_window)

var table info = table.new(position.top_right, 1, 4, bgcolor = color.new(color.black, 80), border_width = 0)
if barstate.islast
    segShort = isIndian ? "INDIAN" : "ROBOT"
    table.cell(info, 0, 0, segShort + " | ext " + str.tostring(extendRight) + " (lines only, no future path)", text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, srcTxt, text_color = color.aqua, text_size = size.small)
    hlTxt = na(frozenH) ? "..." : ("H " + str.tostring(frozenH, format.mintick) + "  L " + str.tostring(frozenL, format.mintick) + "  n=" + str.tostring(frozenCnt))
    table.cell(info, 0, 2, hlTxt, text_color = color.silver, text_size = size.small)
    cbTxt = na(C) ? "Waiting snapshot..." : ("C " + str.tostring(C, format.mintick) + "  B " + str.tostring(B, format.mintick) + "  FROZEN")
    table.cell(info, 0, 3, cbTxt, text_color = color.yellow, text_size = size.small)
