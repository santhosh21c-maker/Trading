//@version=6
// Smart Robotic Logic - Decider and Targets (Educational recreation)
//
// LADDER (verified on vendor screenshots):
//   C = (H+L)/2 , B = (H-L)/2
//   Decider = C +/- 0.06*B
//   Targets = C +/- {1, 1.54, 1.83, 2.08}*B
//
// SEGMENT + EXTEND (confirmed):
//   ROBOT PREDICTION:
//     Extend = prediction lookback only.
//     Changing Extend MUST change Decider/Target PRICE levels (Y positions).
//     Extend does NOT lengthen the lines. Lines use extend.right (fixed visual).
//   INDIAN:
//     Levels FIXED for the day (prior-day H/L).
//     Extend ONLY lengthens horizontal lines. Levels do not move.
//
// Vendor Robot PUT 24500 targets:
//   Ext 50 => Decider 72.22/71.59  H~77.15 L~66.65  C~71.91 B~5.25
//   Ext 60 => Decider 65.97/65.48  H~69.75 L~61.70  C~65.73 B~4.03
//   Note: H50 > H60 at same moment => window cannot be nested last-N.
//         Use shifted block [Extend, 2*Extend) so Ext 50 and 60 differ.
//
indicator("Smart Robotic Logic - Decider and Targets", overlay = true, max_lines_count = 500, max_labels_count = 500, dynamic_requests = false)

grpMain = "Main"
enableLevels = input.bool(true, "Enable Automated Levels", group = grpMain)
segment = input.string("Robot Prediction", "Segment", options = ["INDIAN - Index, Stock & Option", "Robot Prediction"], group = grpMain)
extendIn = input.int(50, "Extend", minval = 2, maxval = 500, group = grpMain, tooltip = "ROBOT: lookback only — changes Decider/Target values, does NOT lengthen lines. INDIAN: line length only — levels stay fixed.")
anchorDate = input.time(timestamp("11 Aug 2026 00:00"), "Anchor Date", group = grpMain)
hybrid5m = input.bool(true, "Hybrid Force 5 Min Values", group = grpMain, tooltip = "INDIAN prior-day on 5m. Robot always uses chart TF (use 1m).")

grpRobot = "Robot Prediction"
robotStartHhmm = input.int(915, "Robot Start HHMM (IST)", minval = 900, maxval = 1500, group = grpRobot)
robotWindow = input.string("Shifted [Ext, 2Ext)", "Robot Window", options = ["Shifted [Ext, 2Ext)", "Last Ext bars", "First Ext bars"], group = grpRobot, tooltip = "Shifted allows Ext50 H > Ext60 H (vendor). Last/First are nested.")
robotHSource = input.string("High", "Robot H Source", options = ["High", "Body high", "Close"], group = grpRobot)
robotLSource = input.string("Low", "Robot L Source", options = ["Low", "Body low", "Close"], group = grpRobot)

grpSnap = "Snapshot / Lines"
forceRecalc = input.bool(false, "Force Recalculate Now", group = grpSnap)
extendLeft = input.int(120, "Extend Lines Left (bars)", minval = 0, maxval = 500, group = grpSnap)
indianExtraRight = input.int(0, "Indian Extra Right (bars)", minval = 0, maxval = 500, group = grpSnap)

grpShow = "Show / Hide"
showDecider = input.bool(true, "Show Decider", group = grpShow)
showUpTgts = input.bool(true, "Show Upper Targets", group = grpShow)
showDnTgts = input.bool(true, "Show Lower Targets", group = grpShow)
showLabels = input.bool(true, "Show Labels", group = grpShow)
showCenter = input.bool(false, "Show Centre C", group = grpShow)

grpLadder = "Ladder (x Base B)"
deciderFrac = input.float(0.06, "Decider +/- x B", step = 0.001, group = grpLadder)
t1Ratio = input.float(1.00, "Target 1 x B", step = 0.01, group = grpLadder)
t2Ratio = input.float(1.54, "Target 2 x B", step = 0.01, group = grpLadder)
t3Ratio = input.float(1.83, "Target 3 x B", step = 0.01, group = grpLadder)
t4Ratio = input.float(2.08, "Target 4 x B", step = 0.01, group = grpLadder)

grpStyle = "Colors"
clrDecider = input.color(color.new(#9E9E9E, 0), "Decider", group = grpStyle)
clrT1 = input.color(color.new(#26A69A, 0), "Target 1", group = grpStyle)
clrT2 = input.color(color.new(#FF9800, 0), "Target 2", group = grpStyle)
clrT3 = input.color(color.new(#EC407A, 0), "Target 3", group = grpStyle)
clrT4 = input.color(color.new(#AB47BC, 0), "Target 4", group = grpStyle)
clrCenter = input.color(color.new(#787B86, 0), "Centre", group = grpStyle)
lineWidth = input.int(1, "Line Width", minval = 1, maxval = 3, group = grpStyle)

isIndian = segment == "INDIAN - Index, Stock & Option"
isRobot = not isIndian
tz = "Asia/Kolkata"

// INDIAN: Extend = visual right length. ROBOT: lines go to right edge (Extend does not lengthen).
indianRight = extendIn + indianExtraRight

f_hhmm(int idx) =>
    hour(time[idx], tz) * 100 + minute(time[idx], tz)

f_same_day(int idx, int d0, int m0, int y0) =>
    dayofmonth(time[idx], tz) == d0 and month(time[idx], tz) == m0 and year(time[idx], tz) == y0

f_pick_h(int idx, string src) =>
    src == "Close" ? close[idx] : src == "Body high" ? math.max(open[idx], close[idx]) : high[idx]

f_pick_l(int idx, string src) =>
    src == "Close" ? close[idx] : src == "Body low" ? math.min(open[idx], close[idx]) : low[idx]

// INDIAN: prior calendar day — Extend never used here
f_prior_day_hl() =>
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    float h = na
    float l = na
    int maxScan = math.min(bar_index, 5000)
    bool inPrior = false
    int priorD = na
    int priorM = na
    int priorY = na
    for i = 1 to maxScan
        int di = dayofmonth(time[i], tz)
        int mi = month(time[i], tz)
        int yi = year(time[i], tz)
        bool sameAsToday = di == d0 and mi == m0 and yi == y0
        if not sameAsToday
            if not inPrior
                inPrior := true
                priorD := di
                priorM := mi
                priorY := yi
                h := high[i]
                l := low[i]
            else if di == priorD and mi == priorM and yi == priorY
                h := math.max(h, high[i])
                l := math.min(l, low[i])
            else
                break
    [h, l]

[hDayOwn, lDayOwn] = f_prior_day_hl()
[hDay5, lDay5] = request.security(syminfo.tickerid, "5", f_prior_day_hl(), lookahead = barmerge.lookahead_off)

// ROBOT: Extend-sized window. Shifted by default so Ext50/Ext60 can differ (incl. H50>H60).
f_robot_hl(int len, int startHhmm, string winMode, string hSrc, string lSrc) =>
    float h = na
    float l = na
    int cnt = 0
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    int maxScan = math.min(bar_index, 5000)

    if winMode == "Shifted [Ext, 2Ext)"
        int iFrom = len
        int iTo = math.min(2 * len - 1, bar_index)
        if iFrom <= iTo
            for i = iFrom to iTo
                if f_same_day(i, d0, m0, y0) and f_hhmm(i) >= startHhmm
                    float bh = f_pick_h(i, hSrc)
                    float bl = f_pick_l(i, lSrc)
                    h := na(h) ? bh : math.max(h, bh)
                    l := na(l) ? bl : math.min(l, bl)
                    cnt += 1
        // If shifted block too thin, fall back to last `len` valid bars
        if cnt < math.max(5, int(len * 0.25))
            h := na
            l := na
            cnt := 0
            for i = 1 to maxScan
                if cnt >= len
                    break
                if f_same_day(i, d0, m0, y0) and f_hhmm(i) >= startHhmm
                    float bh = f_pick_h(i, hSrc)
                    float bl = f_pick_l(i, lSrc)
                    h := na(h) ? bh : math.max(h, bh)
                    l := na(l) ? bl : math.min(l, bl)
                    cnt += 1
                else if not f_same_day(i, d0, m0, y0)
                    break
    else if winMode == "First Ext bars"
        int dayBars = 0
        for i = 1 to maxScan
            if f_same_day(i, d0, m0, y0)
                dayBars += 1
            else
                break
        if dayBars > 0
            for i = dayBars to 1
                if f_hhmm(i) >= startHhmm
                    float bh = f_pick_h(i, hSrc)
                    float bl = f_pick_l(i, lSrc)
                    h := na(h) ? bh : math.max(h, bh)
                    l := na(l) ? bl : math.min(l, bl)
                    cnt += 1
                    if cnt >= len
                        break
    else
        // Last Ext bars
        for i = 1 to maxScan
            if cnt >= len
                break
            if f_same_day(i, d0, m0, y0) and f_hhmm(i) >= startHhmm
                float bh = f_pick_h(i, hSrc)
                float bl = f_pick_l(i, lSrc)
                h := na(h) ? bh : math.max(h, bh)
                l := na(l) ? bl : math.min(l, bl)
                cnt += 1
            else if not f_same_day(i, d0, m0, y0)
                break
    [h, l, cnt]

[hRob, lRob, nRob] = f_robot_hl(extendIn, robotStartHhmm, robotWindow, robotHSource, robotLSource)

rawH = isIndian ? (hybrid5m ? hDay5 : hDayOwn) : hRob
rawL = isIndian ? (hybrid5m ? lDay5 : lDayOwn) : lRob

winTag = robotWindow == "Shifted [Ext, 2Ext)" ? "shift" : robotWindow == "First Ext bars" ? "first" : "last"
srcTxt = isIndian ? "INDIAN prior-day FIXED | Ext=line length only" : ("ROBOT " + winTag + "[" + str.tostring(extendIn) + "] n=" + str.tostring(nRob) + " | Ext changes LEVELS, not line length")

liveC = (rawH + rawL) / 2.0
liveB = (rawH - rawL) / 2.0

var float frozenC = na
var float frozenB = na
var float frozenH = na
var float frozenL = na
var string frozenSeg = "INIT"
var int frozenDate = -1
var int frozenHyb = -1
var int frozenForce = -1
var int frozenExt = -999
var int frozenStart = -1
var string frozenWin = "INIT"
var string frozenHS = "INIT"
var string frozenLS = "INIT"
var int frozenN = -1

hybFlag = hybrid5m ? 1 : 0
forceFlag = forceRecalc ? 1 : 0

// INDIAN: Extend must NOT resnapshot levels
// ROBOT: Extend MUST resnapshot levels
baseChanged = segment != frozenSeg or anchorDate != frozenDate or hybFlag != frozenHyb or forceFlag != frozenForce
robotChanged = baseChanged or extendIn != frozenExt or robotStartHhmm != frozenStart or robotWindow != frozenWin or robotHSource != frozenHS or robotLSource != frozenLS
recipeChanged = isIndian ? baseChanged : robotChanged

canSnap = enableLevels and barstate.islast and not na(liveC) and not na(liveB) and liveB > 0
shouldSnapshot = canSnap and (recipeChanged or na(frozenC))

if shouldSnapshot
    frozenC := liveC
    frozenB := liveB
    frozenH := rawH
    frozenL := rawL
    frozenSeg := segment
    frozenDate := anchorDate
    frozenHyb := hybFlag
    frozenForce := forceFlag
    frozenExt := extendIn
    frozenStart := robotStartHhmm
    frozenWin := robotWindow
    frozenHS := robotHSource
    frozenLS := robotLSource
    frozenN := isRobot ? nRob : 0

C = frozenC
B = frozenB
decHi = C + deciderFrac * B
decLo = C - deciderFrac * B
upT1 = C + t1Ratio * B
upT2 = C + t2Ratio * B
upT3 = C + t3Ratio * B
upT4 = C + t4Ratio * B
dnT1 = C - t1Ratio * B
dnT2 = C - t2Ratio * B
dnT3 = C - t3Ratio * B
dnT4 = C - t4Ratio * B

var line[] lines = array.new_line()
var label[] labels = array.new_label()

f_clear() =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

f_level(float price, string txt, color lineCol, bool showLine) =>
    if not na(price) and showLine
        int x1 = bar_index - extendLeft
        // ROBOT: extend.right — Extend does not control length
        // INDIAN: fixed bar length from Extend
        if isRobot
            line ln = line.new(x1, price, bar_index, price, xloc = xloc.bar_index, extend = extend.right, color = lineCol, style = line.style_dashed, width = lineWidth)
            array.push(lines, ln)
            if showLabels
                label lb = label.new(bar_index, price, txt + " / " + str.tostring(price, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(lineCol, 85), textcolor = lineCol, size = size.small)
                array.push(labels, lb)
        else
            int x2 = bar_index + indianRight
            line ln = line.new(x1, price, x2, price, xloc = xloc.bar_index, extend = extend.none, color = lineCol, style = line.style_dashed, width = lineWidth)
            array.push(lines, ln)
            if showLabels
                label lb = label.new(x2, price, txt + " / " + str.tostring(price, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(lineCol, 85), textcolor = lineCol, size = size.small)
                array.push(labels, lb)

if barstate.islast and enableLevels and not na(C) and not na(B) and B > 0
    f_clear()
    if showDecider
        f_level(decHi, "Decider", clrDecider, true)
        f_level(decLo, "Decider", clrDecider, true)
    if showCenter
        f_level(C, "Centre", clrCenter, true)
    if showUpTgts
        f_level(upT1, "Target 1", clrT1, true)
        f_level(upT2, "Target 2", clrT2, true)
        f_level(upT3, "Target 3", clrT3, true)
        f_level(upT4, "Target 4", clrT4, true)
    if showDnTgts
        f_level(dnT1, "Target 1", clrT1, true)
        f_level(dnT2, "Target 2", clrT2, true)
        f_level(dnT3, "Target 3", clrT3, true)
        f_level(dnT4, "Target 4", clrT4, true)

bgcolor(color.new(color.black, 100))
plot(close, title = "seed", display = display.none)
plot(enableLevels ? frozenH : na, "Window High", display = display.data_window)
plot(enableLevels ? frozenL : na, "Window Low", display = display.data_window)
plot(enableLevels ? C : na, "Centre C", color = clrCenter, display = display.data_window)
plot(enableLevels ? B : na, "Base B", color = clrCenter, display = display.data_window)
plot(enableLevels and showDecider ? decHi : na, "Decider High", color = clrDecider, display = display.data_window)
plot(enableLevels and showDecider ? decLo : na, "Decider Low", color = clrDecider, display = display.data_window)
plot(enableLevels and showUpTgts ? upT1 : na, "Up T1", color = clrT1, display = display.data_window)
plot(enableLevels and showDnTgts ? dnT1 : na, "Dn T1", color = clrT1, display = display.data_window)

var table info = table.new(position.top_right, 1, 5, bgcolor = color.new(color.black, 80), border_width = 0)
if barstate.islast
    segShort = isIndian ? "INDIAN" : "ROBOT"
    extNote = isIndian ? "Ext=LINE LENGTH" : "Ext=LEVELS ONLY (no line lengthen)"
    table.cell(info, 0, 0, segShort + " | Ext " + str.tostring(extendIn) + " | " + extNote, text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, srcTxt, text_color = color.aqua, text_size = size.small)
    hlTxt = na(frozenH) ? "..." : ("H " + str.tostring(frozenH, format.mintick) + "  L " + str.tostring(frozenL, format.mintick) + "  n=" + str.tostring(frozenN))
    table.cell(info, 0, 2, hlTxt, text_color = color.silver, text_size = size.small)
    cbTxt = na(C) ? "Waiting..." : ("C " + str.tostring(C, format.mintick) + "  B " + str.tostring(B, format.mintick) + "  FROZEN")
    table.cell(info, 0, 3, cbTxt, text_color = color.yellow, text_size = size.small)
    decTxt = na(decHi) ? "" : ("Dec " + str.tostring(decHi, format.mintick) + " / " + str.tostring(decLo, format.mintick))
    table.cell(info, 0, 4, decTxt, text_color = color.orange, text_size = size.small)
