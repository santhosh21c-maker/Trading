//@version=6
// Smart Robotic Logic - Decider and Targets (Educational recreation)
//
// LADDER:
//   C = (H+L)/2 , B = (H-L)/2
//   Decider = C +/- 0.06*B
//   Targets = C +/- {1, 1.54, 1.83, 2.08}*B
//
// BEHAVIOUR:
//   ROBOT: Extend changes levels (LIVE). Lines = fixed short length.
//   INDIAN: prior-day FROZEN. Extend = line length only.
//
// WHY LAST-N FAILED AT ONE CLOCK TIME:
//   Vendor Ext50 H~77 > Ext60 H~70 at the SAME time (price~61.70).
//   Nested last/first windows cannot do that. Ext50 must read an OLDER
//   morning slice (before the ~59 dump); Ext60 reads RECENT bars.
//
// AUTO-LAG (default):
//   lag = max(0, 5*(60-Extend))
//   Ext50 => lag 50 => bars [50..99]  (≈09:20–10:10 @11:00) aim H77 L66.65
//   Ext60 => lag  0 => bars [1..60]   (≈10:00–11:00 @11:00) aim H70 L61.70
//
indicator("Smart Robotic Logic - Decider and Targets", overlay = true, max_lines_count = 500, max_labels_count = 500, dynamic_requests = false)

grpMain = "Main"
enableLevels = input.bool(true, "Enable Automated Levels", group = grpMain)
segment = input.string("Robot Prediction", "Segment", options = ["INDIAN - Index, Stock & Option", "Robot Prediction"], group = grpMain)
extendIn = input.int(50, "Extend", minval = 2, maxval = 500, group = grpMain, tooltip = "ROBOT: lookback size + auto-lag anchor (changes Decider/Targets). INDIAN: line length only.")
anchorDate = input.time(timestamp("11 Aug 2026 00:00"), "Anchor Date", group = grpMain)
hybrid5m = input.bool(true, "Hybrid Force 5 Min Values", group = grpMain, tooltip = "INDIAN only.")

grpRobot = "Robot Prediction"
robotMode = input.string("Auto lag (Ext50 old / Ext60 recent)", "Robot Window", options = ["Auto lag (Ext50 old / Ext60 recent)", "Last Ext bars", "First Ext bars", "Offset [Ext, 2Ext)"], group = grpRobot, tooltip = "Auto lag: Ext50 peeks ~50 bars back; Ext60 uses last 60. Needed because vendor H50>H60 at one time.")
robotStartHhmm = input.int(915, "Robot Start HHMM (IST)", minval = 900, maxval = 1500, group = grpRobot, tooltip = "Ignore bars before this time.")
robotLagManual = input.int(0, "Manual Lag (if not Auto)", minval = 0, maxval = 500, group = grpRobot)
robotHSource = input.string("High", "Robot H Source", options = ["High", "Body high", "Close"], group = grpRobot)
robotLSource = input.string("Body low", "Robot L Source", options = ["Low", "Body low", "Close"], group = grpRobot)
robotTrimPct = input.float(10.0, "Trim extremes %", minval = 0.0, maxval = 40.0, step = 5.0, group = grpRobot, tooltip = "Drop this % of highest highs / lowest lows before min/max (helps Ext60 L 59→~62). Set 0 for raw min/max.")
robotLineRight = input.int(40, "Robot Line Right (bars)", minval = 5, maxval = 200, group = grpRobot)
robotLineLeft = input.int(10, "Robot Line Left (bars)", minval = 0, maxval = 200, group = grpRobot)

grpSnap = "Indian Freeze / Lines"
forceRecalc = input.bool(false, "Force Recalculate Now (Indian)", group = grpSnap)
indianLineLeft = input.int(60, "Indian Line Left (bars)", minval = 0, maxval = 500, group = grpSnap)
indianExtraRight = input.int(0, "Indian Extra Right (bars)", minval = 0, maxval = 500, group = grpSnap)

grpShow = "Show / Hide"
showDecider = input.bool(true, "Show Decider", group = grpShow)
showUpTgts = input.bool(true, "Show Upper Targets", group = grpShow)
showDnTgts = input.bool(true, "Show Lower Targets", group = grpShow)
showLabels = input.bool(true, "Show Labels", group = grpShow)
showCenter = input.bool(false, "Show Centre C", group = grpShow)

grpLadder = "Ladder (x Base B)"
deciderFrac = input.float(0.06, "Decider +/- x B", step = 0.001, group = grpLadder)
t1Ratio = input.float(1.00, "Target 1 x B", step = 0.01, group = grpLadder)
t2Ratio = input.float(1.54, "Target 2 x B", step = 0.01, group = grpLadder)
t3Ratio = input.float(1.83, "Target 3 x B", step = 0.01, group = grpLadder)
t4Ratio = input.float(2.08, "Target 4 x B", step = 0.01, group = grpLadder)

grpStyle = "Colors"
clrDecider = input.color(color.new(#9E9E9E, 0), "Decider", group = grpStyle)
clrT1 = input.color(color.new(#26A69A, 0), "Target 1", group = grpStyle)
clrT2 = input.color(color.new(#FF9800, 0), "Target 2", group = grpStyle)
clrT3 = input.color(color.new(#EC407A, 0), "Target 3", group = grpStyle)
clrT4 = input.color(color.new(#AB47BC, 0), "Target 4", group = grpStyle)
clrCenter = input.color(color.new(#787B86, 0), "Centre", group = grpStyle)
lineWidth = input.int(1, "Line Width", minval = 1, maxval = 3, group = grpStyle)

isIndian = segment == "INDIAN - Index, Stock & Option"
isRobot = not isIndian
tz = "Asia/Kolkata"
indianRight = extendIn + indianExtraRight

f_hhmm(int idx) =>
    hour(time[idx], tz) * 100 + minute(time[idx], tz)

f_same_day(int idx, int d0, int m0, int y0) =>
    dayofmonth(time[idx], tz) == d0 and month(time[idx], tz) == m0 and year(time[idx], tz) == y0

f_pick_h(int idx, string src) =>
    src == "Close" ? close[idx] : src == "Body high" ? math.max(open[idx], close[idx]) : high[idx]

f_pick_l(int idx, string src) =>
    src == "Close" ? close[idx] : src == "Body low" ? math.min(open[idx], close[idx]) : low[idx]

f_prior_day_hl() =>
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    float h = na
    float l = na
    int maxScan = math.min(bar_index, 5000)
    bool inPrior = false
    int priorD = na
    int priorM = na
    int priorY = na
    for i = 1 to maxScan
        int di = dayofmonth(time[i], tz)
        int mi = month(time[i], tz)
        int yi = year(time[i], tz)
        bool sameAsToday = di == d0 and mi == m0 and yi == y0
        if not sameAsToday
            if not inPrior
                inPrior := true
                priorD := di
                priorM := mi
                priorY := yi
                h := high[i]
                l := low[i]
            else if di == priorD and mi == priorM and yi == priorY
                h := math.max(h, high[i])
                l := math.min(l, low[i])
            else
                break
    [h, l]

[hDayOwn, lDayOwn] = f_prior_day_hl()
[hDay5, lDay5] = request.security(syminfo.tickerid, "5", f_prior_day_hl(), lookahead = barmerge.lookahead_off)

f_trim_hl(float[] hs, float[] ls, float trimPct) =>
    float hOut = na
    float lOut = na
    int n = array.size(hs)
    if n > 0
        if trimPct <= 0 or n < 5
            hOut := array.max(hs)
            lOut := array.min(ls)
        else
            float[] hs2 = array.copy(hs)
            float[] ls2 = array.copy(ls)
            array.sort(hs2, order.ascending)
            array.sort(ls2, order.ascending)
            int drop = int(math.floor(n * trimPct / 100.0))
            drop := math.min(drop, int(math.floor((n - 1) / 2)))
            int hiIdx = n - 1 - drop
            int loIdx = drop
            hOut := array.get(hs2, hiIdx)
            lOut := array.get(ls2, loIdx)
    [hOut, lOut]

f_robot_hl(int len, int startHhmm, string mode, string hSrc, string lSrc, int manualLag, float trimPct) =>
    float h = na
    float l = na
    int cnt = 0
    int iFrom = na
    int iTo = na
    int usedLag = 0
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    int maxScan = math.min(bar_index, 5000)
    float[] hs = array.new_float()
    float[] ls = array.new_float()

    if mode == "Auto lag (Ext50 old / Ext60 recent)"
        // Ext50 => lag 50 (older morning). Ext60 => lag 0 (recent).
        usedLag := math.max(0, 5 * (60 - len))
        int iStart = usedLag + 1
        int iEnd = usedLag + len
        iTo := iStart
        iFrom := iEnd
        if iStart <= bar_index
            int iLast = math.min(iEnd, bar_index)
            for i = iStart to iLast
                if f_same_day(i, d0, m0, y0) and f_hhmm(i) >= startHhmm
                    array.push(hs, f_pick_h(i, hSrc))
                    array.push(ls, f_pick_l(i, lSrc))
                    cnt += 1
                    if cnt == 1
                        iTo := i
                    iFrom := i
    else if mode == "Last Ext bars"
        usedLag := manualLag
        int iStart = manualLag + 1
        iTo := iStart
        iFrom := iStart
        for i = iStart to maxScan
            if cnt >= len
                break
            if f_same_day(i, d0, m0, y0) and f_hhmm(i) >= startHhmm
                array.push(hs, f_pick_h(i, hSrc))
                array.push(ls, f_pick_l(i, lSrc))
                cnt += 1
                if cnt == 1
                    iTo := i
                iFrom := i
            else if not f_same_day(i, d0, m0, y0)
                break
    else if mode == "Offset [Ext, 2Ext)"
        usedLag := len
        iFrom := len
        iTo := 2 * len - 1
        if iFrom <= bar_index
            int iEnd = math.min(iTo, bar_index)
            for i = iFrom to iEnd
                if f_same_day(i, d0, m0, y0) and f_hhmm(i) >= startHhmm
                    array.push(hs, f_pick_h(i, hSrc))
                    array.push(ls, f_pick_l(i, lSrc))
                    cnt += 1
                    if na(iTo) or i < iTo
                        iTo := i
                    if na(iFrom) or i > iFrom
                        iFrom := i
    else
        // First Ext bars after Start
        usedLag := 0
        int dayBars = 0
        for i = 1 to maxScan
            if f_same_day(i, d0, m0, y0)
                dayBars += 1
            else
                break
        iFrom := dayBars
        iTo := 1
        if dayBars > 0
            for i = dayBars to 1
                if f_hhmm(i) >= startHhmm
                    array.push(hs, f_pick_h(i, hSrc))
                    array.push(ls, f_pick_l(i, lSrc))
                    cnt += 1
                    if cnt == 1
                        iFrom := i
                    iTo := i
                    if cnt >= len
                        break

    [hTmp, lTmp] = f_trim_hl(hs, ls, trimPct)
    h := hTmp
    l := lTmp
    [h, l, cnt, iFrom, iTo, usedLag]

[hRob, lRob, nRob, i0, i1, lagUsed] = f_robot_hl(extendIn, robotStartHhmm, robotMode, robotHSource, robotLSource, robotLagManual, robotTrimPct)

rawH = isIndian ? (hybrid5m ? hDay5 : hDayOwn) : hRob
rawL = isIndian ? (hybrid5m ? lDay5 : lDayOwn) : lRob
liveC = (rawH + rawL) / 2.0
liveB = (rawH - rawL) / 2.0

var float frozenC = na
var float frozenB = na
var float frozenH = na
var float frozenL = na
var string frozenSeg = "INIT"
var int frozenDate = -1
var int frozenHyb = -1
var int frozenForce = -1

hybFlag = hybrid5m ? 1 : 0
forceFlag = forceRecalc ? 1 : 0
indianChanged = segment != frozenSeg or anchorDate != frozenDate or hybFlag != frozenHyb or forceFlag != frozenForce
canSnapIndian = enableLevels and isIndian and barstate.islast and not na(liveC) and not na(liveB) and liveB > 0
if canSnapIndian and (indianChanged or na(frozenC))
    frozenC := liveC
    frozenB := liveB
    frozenH := rawH
    frozenL := rawL
    frozenSeg := segment
    frozenDate := anchorDate
    frozenHyb := hybFlag
    frozenForce := forceFlag

C = isRobot ? liveC : frozenC
B = isRobot ? liveB : frozenB
dispH = isRobot ? rawH : frozenH
dispL = isRobot ? rawL : frozenL

decHi = C + deciderFrac * B
decLo = C - deciderFrac * B
upT1 = C + t1Ratio * B
upT2 = C + t2Ratio * B
upT3 = C + t3Ratio * B
upT4 = C + t4Ratio * B
dnT1 = C - t1Ratio * B
dnT2 = C - t2Ratio * B
dnT3 = C - t3Ratio * B
dnT4 = C - t4Ratio * B

var line[] lines = array.new_line()
var label[] labels = array.new_label()

f_clear() =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

f_level(float price, string txt, color lineCol, bool showLine) =>
    if not na(price) and showLine
        int x1 = isRobot ? bar_index - robotLineLeft : bar_index - indianLineLeft
        int x2 = isRobot ? bar_index + robotLineRight : bar_index + indianRight
        line ln = line.new(x1, price, x2, price, xloc = xloc.bar_index, extend = extend.none, color = lineCol, style = line.style_dashed, width = lineWidth)
        array.push(lines, ln)
        if showLabels
            label lb = label.new(x2, price, txt + " / " + str.tostring(price, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(lineCol, 85), textcolor = lineCol, size = size.small)
            array.push(labels, lb)

if barstate.islast and enableLevels and not na(C) and not na(B) and B > 0
    f_clear()
    if showDecider
        f_level(decHi, "Decider", clrDecider, true)
        f_level(decLo, "Decider", clrDecider, true)
    if showCenter
        f_level(C, "Centre", clrCenter, true)
    if showUpTgts
        f_level(upT1, "Target 1", clrT1, true)
        f_level(upT2, "Target 2", clrT2, true)
        f_level(upT3, "Target 3", clrT3, true)
        f_level(upT4, "Target 4", clrT4, true)
    if showDnTgts
        f_level(dnT1, "Target 1", clrT1, true)
        f_level(dnT2, "Target 2", clrT2, true)
        f_level(dnT3, "Target 3", clrT3, true)
        f_level(dnT4, "Target 4", clrT4, true)

bgcolor(color.new(color.black, 100))
plot(close, title = "seed", display = display.none)
plot(enableLevels ? dispH : na, "Window High", display = display.data_window)
plot(enableLevels ? dispL : na, "Window Low", display = display.data_window)
plot(enableLevels ? C : na, "Centre C", color = clrCenter, display = display.data_window)
plot(enableLevels ? B : na, "Base B", color = clrCenter, display = display.data_window)
plot(enableLevels and showDecider ? decHi : na, "Decider High", color = clrDecider, display = display.data_window)
plot(enableLevels and showDecider ? decLo : na, "Decider Low", color = clrDecider, display = display.data_window)

var table info = table.new(position.top_right, 1, 6, bgcolor = color.new(color.black, 80), border_width = 0)
if barstate.islast
    segShort = isIndian ? "INDIAN" : "ROBOT"
    table.cell(info, 0, 0, segShort + " | Ext " + str.tostring(extendIn) + (isRobot ? " | LIVE" : " | FROZEN"), text_color = color.white, text_size = size.small)
    if isRobot
        modeTag = robotMode == "Last Ext bars" ? "last" : robotMode == "Offset [Ext, 2Ext)" ? "offset" : robotMode == "First Ext bars" ? "first" : "alag"
        t0 = na(i0) ? "—" : str.tostring(f_hhmm(i0))
        t1 = na(i1) ? "—" : str.tostring(f_hhmm(i1))
        table.cell(info, 0, 1, modeTag + " n=" + str.tostring(nRob) + " lag=" + str.tostring(lagUsed) + " " + t0 + "-" + t1, text_color = color.aqua, text_size = size.small)
        tip = extendIn == 50 ? "aim H77.15 L66.65" : extendIn == 60 ? "aim H69.75 L61.70" : ""
        table.cell(info, 0, 5, tip, text_color = color.gray, text_size = size.tiny)
    else
        table.cell(info, 0, 1, "prior-day | Ext=line length", text_color = color.aqua, text_size = size.small)
        table.cell(info, 0, 5, "", text_color = color.gray, text_size = size.tiny)
    hlTxt = na(dispH) ? "Waiting..." : ("H " + str.tostring(dispH, format.mintick) + "  L " + str.tostring(dispL, format.mintick))
    table.cell(info, 0, 2, hlTxt, text_color = color.silver, text_size = size.small)
    cbTxt = na(C) ? "..." : ("C " + str.tostring(C, format.mintick) + "  B " + str.tostring(B, format.mintick))
    table.cell(info, 0, 3, cbTxt, text_color = color.yellow, text_size = size.small)
    aim = extendIn == 60 ? "aim 65.97/65.48" : extendIn == 50 ? "aim 72.22/71.59" : ""
    decTxt = na(decHi) ? "" : ("Dec " + str.tostring(decHi, format.mintick) + " / " + str.tostring(decLo, format.mintick) + "  " + aim)
    table.cell(info, 0, 4, decTxt, text_color = color.orange, text_size = size.small)
