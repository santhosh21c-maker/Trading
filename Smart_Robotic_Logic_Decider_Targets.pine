//@version=6
// Smart Robotic Logic - Decider and Targets Educational recreation
//
// HOW LEVELS ARE PLOTTED — see HOW_LEVELS_ARE_PLOTTED.md
//
// TWO CLAIMS (keep separate):
//   A) Ladder algebra (verified): C=(H+L)/2, B=(H-L)/2
//      Decider = C ± 0.06·B
//      Targets = C ± {1.00, 1.54, 1.83, 2.08}·B  → T1 labels ARE the anchors H/L
//   B) What H/L are (testable): on Nifty INDEX 14 Aug 2026, vendor T1 matched
//      prior Close/Low (24395.85 / 24311.40), NOT prior High/Low (24431.60 / …).
//      Default INDIAN source: Prev Close + Prev Low (chart scan).
//      If auto still disagrees with vendor: Manual Target 1 = paste vendor T1.
//
// SEGMENTS:
//   INDIAN - prior-day FROZEN. Extend = line length only.
//   Robot Prediction - LIVE Extend window. Same ladder ratios.
//
// BUG FIXED: f_add_mins must use int division Ext50 OR 930-1005 not 1004-1037.

indicator("Smart Robotic Logic - Decider and Targets", overlay = true, max_lines_count = 500, max_labels_count = 500, dynamic_requests = false)

grpMain = "Main"
enableLevels = input.bool(true, "Enable Automated Levels", group = grpMain)
segment = input.string("INDIAN - Index, Stock & Option", "Segment", options = ["INDIAN - Index, Stock & Option", "Robot Prediction"], group = grpMain)
extendIn = input.int(50, "Extend", minval = 2, maxval = 500, group = grpMain)
anchorDate = input.time(timestamp("13 Aug 2026 00:00"), "Anchor Date", group = grpMain)
indianHlSrc = input.string("Prev Close + Prev Low (chart)", "INDIAN H/L Source", options = ["Prev Close + Prev Low (chart)", "Prev Close + Prev Low (Daily)", "Prev NSE session High/Low", "Prev NSE session 5m High/Low", "Prior day OR 0930-1005", "Chart TF calendar High/Low", "Daily High/Low series", "Manual Target 1"], group = grpMain, tooltip = "INDEX 14 Aug 2026 vendor T1 matched prior Close/Low.\nChart scan is preferred over Daily series (TV Daily can drift on NSE).\nManual = paste vendor Target 1 High/Low if auto still disagrees.")
i_sess_a = input.int(915, "NSE session start HHMM", minval=900, maxval=1600, group = grpMain)
i_sess_b = input.int(1530, "NSE session end HHMM", minval=900, maxval=1600, group = grpMain)
i_manH = input.float(0.0, "Manual H = vendor Target 1 High", step=0.05, group = grpMain)
i_manL = input.float(0.0, "Manual L = vendor Target 1 Low", step=0.05, group = grpMain)
i_showHlDbg = input.bool(true, "Show H/L source debug", group = grpMain)

grpRobot = "Robot Prediction"
robotMode = input.string("Auto OR-Last", "Robot Window", options = ["Auto OR-Last", "Last Ext bars", "First Ext bars", "Offset Ext to 2Ext"], group = grpRobot)
robotStartHhmm = input.int(915, "Robot Start HHMM IST", minval = 900, maxval = 1500, group = grpRobot)
robotOrSkipMins = input.int(15, "OR Skip Open mins", minval = 0, maxval = 60, group = grpRobot)
robotLagManual = input.int(0, "Manual Lag Last mode", minval = 0, maxval = 500, group = grpRobot)
robotHSource = input.string("High", "Robot H Source", options = ["High", "Body high", "Close"], group = grpRobot)
robotLSource = input.string("Body low", "Robot L Source", options = ["Low", "Body low", "Close"], group = grpRobot)
robotTrimHighPct = input.float(10.0, "Trim highs pct Last Ext60", minval = 0.0, maxval = 40.0, step = 5.0, group = grpRobot)
robotTrimLowPct = input.float(25.0, "Trim lows pct Last Ext60", minval = 0.0, maxval = 40.0, step = 5.0, group = grpRobot)
robotLineRight = input.int(40, "Robot Line Right bars", minval = 5, maxval = 200, group = grpRobot)
robotLineLeft = input.int(10, "Robot Line Left bars", minval = 0, maxval = 200, group = grpRobot)

grpSnap = "Indian Freeze / Lines"
forceRecalc = input.bool(false, "Force Recalculate Now Indian", group = grpSnap)
indianLineLeft = input.int(60, "Indian Line Left bars", minval = 0, maxval = 500, group = grpSnap)
indianExtraRight = input.int(0, "Indian Extra Right bars", minval = 0, maxval = 500, group = grpSnap)
indianExtendRight = input.bool(true, "Indian lines extend right", group = grpSnap)

grpShow = "Show / Hide"
showDecider = input.bool(true, "Show Decider", group = grpShow)
showUpTgts = input.bool(true, "Show Upper Targets", group = grpShow)
showDnTgts = input.bool(true, "Show Lower Targets", group = grpShow)
showLabels = input.bool(true, "Show Labels", group = grpShow)
showCenter = input.bool(false, "Show Centre C", group = grpShow)
showPlots = input.bool(true, "Show price-scale plots", group = grpShow)

grpLadder = "Ladder x Base B"
deciderFrac = input.float(0.06, "Decider +/- x B", step = 0.001, group = grpLadder)
t1Ratio = input.float(1.00, "Target 1 x B", step = 0.01, group = grpLadder)
t2Ratio = input.float(1.54, "Target 2 x B", step = 0.01, group = grpLadder)
t3Ratio = input.float(1.83, "Target 3 x B", step = 0.01, group = grpLadder)
t4Ratio = input.float(2.08, "Target 4 x B", step = 0.01, group = grpLadder)

grpStyle = "Colors"
clrDecider = input.color(color.new(#EC407A, 0), "Decider", group = grpStyle)
clrT1 = input.color(color.new(#26A69A, 0), "Target 1", group = grpStyle)
clrT2 = input.color(color.new(#26A69A, 0), "Target 2", group = grpStyle)
clrT3 = input.color(color.new(#EF5350, 0), "Target 3", group = grpStyle)
clrT4 = input.color(color.new(#EF5350, 0), "Target 4", group = grpStyle)
clrCenter = input.color(color.new(#787B86, 0), "Centre", group = grpStyle)
lineWidth = input.int(1, "Line Width", minval = 1, maxval = 3, group = grpStyle)

isIndian = segment == "INDIAN - Index, Stock & Option"
isRobot = not isIndian
tz = "Asia/Kolkata"
indianRight = extendIn + indianExtraRight

f_hhmm(int idx) =>
    hour(time[idx], tz) * 100 + minute(time[idx], tz)

f_in_nse(int idx) =>
    int hm = f_hhmm(idx)
    hm >= i_sess_a and hm <= i_sess_b

f_same_day(int idx, int d0, int m0, int y0) =>
    dayofmonth(time[idx], tz) == d0 and month(time[idx], tz) == m0 and year(time[idx], tz) == y0

// MUST use int on divisions — Pine / is float and produced OR 1004-1037 instead of 930-1005
f_add_mins(int hhmm, int mins) =>
    int h = int(hhmm / 100)
    int m = hhmm % 100
    int total = h * 60 + m + mins
    int nh = int(total / 60)
    int nm = total % 60
    nh * 100 + nm

f_pick_h(int idx, string src) =>
    src == "Close" ? close[idx] : src == "Body high" ? math.max(open[idx], close[idx]) : high[idx]

f_pick_l(int idx, string src) =>
    src == "Close" ? close[idx] : src == "Body low" ? math.min(open[idx], close[idx]) : low[idx]

// Build NSE session string e.g. 0915-1530
f_sess_str() =>
    sa = i_sess_a < 1000 ? "0" + str.tostring(i_sess_a) : str.tostring(i_sess_a)
    sb = i_sess_b < 1000 ? "0" + str.tostring(i_sess_b) : str.tostring(i_sess_b)
    sa + "-" + sb

// Track previous COMPLETED NSE session H/L via session calendar change
f_prev_nse_session_hl() =>
    string sess = f_sess_str()
    var float curH = na
    var float curL = na
    var float prevH = na
    var float prevL = na
    bool newSess = ta.change(time("D", sess, tz)) != 0
    bool inSess = not na(time(timeframe.period, sess, tz))
    if newSess
        prevH := curH
        prevL := curL
        curH := inSess ? high : float(na)
        curL := inSess ? low : float(na)
    else if inSess
        curH := na(curH) ? high : math.max(curH, high)
        curL := na(curL) ? low : math.min(curL, low)
    [prevH, prevL]

// Prior NSE session Close + Low from chart bars (avoids TV Daily series drift)
f_prev_session_close_low() =>
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    float sessL = na
    float sessC = na
    int maxScan = math.min(bar_index, 8000)
    bool inPrior = false
    int priorD = na
    int priorM = na
    int priorY = na
    for i = 1 to maxScan
        int di = dayofmonth(time[i], tz)
        int mi = month(time[i], tz)
        int yi = year(time[i], tz)
        bool sameAsToday = di == d0 and mi == m0 and yi == y0
        if not sameAsToday
            if not inPrior
                inPrior := true
                priorD := di
                priorM := mi
                priorY := yi
            if di == priorD and mi == priorM and yi == priorY
                if f_in_nse(i)
                    if na(sessC)
                        sessC := close[i]
                    sessL := na(sessL) ? low[i] : math.min(sessL, low[i])
            else if inPrior
                break
    [sessC, sessL]

// Prior IST calendar day High/Low using only NSE session bars
f_prior_day_hl() =>
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    float h = na
    float l = na
    int maxScan = math.min(bar_index, 8000)
    bool inPrior = false
    int priorD = na
    int priorM = na
    int priorY = na
    for i = 1 to maxScan
        int di = dayofmonth(time[i], tz)
        int mi = month(time[i], tz)
        int yi = year(time[i], tz)
        bool sameAsToday = di == d0 and mi == m0 and yi == y0
        if not sameAsToday
            if not inPrior
                inPrior := true
                priorD := di
                priorM := mi
                priorY := yi
            if di == priorD and mi == priorM and yi == priorY
                if f_in_nse(i)
                    h := na(h) ? high[i] : math.max(h, high[i])
                    l := na(l) ? low[i] : math.min(l, low[i])
            else if inPrior
                break
    [h, l]

// Prior day Opening Range H/L e.g. 0930-1005
f_prior_or_hl(int orStart, int orEnd) =>
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    float h = na
    float l = na
    int maxScan = math.min(bar_index, 8000)
    bool inPrior = false
    int priorD = na
    int priorM = na
    int priorY = na
    for i = 1 to maxScan
        int di = dayofmonth(time[i], tz)
        int mi = month(time[i], tz)
        int yi = year(time[i], tz)
        bool sameAsToday = di == d0 and mi == m0 and yi == y0
        if not sameAsToday
            if not inPrior
                inPrior := true
                priorD := di
                priorM := mi
                priorY := yi
            if di == priorD and mi == priorM and yi == priorY
                int hm = f_hhmm(i)
                if hm >= orStart and hm < orEnd
                    h := na(h) ? high[i] : math.max(h, high[i])
                    l := na(l) ? low[i] : math.min(l, low[i])
            else if inPrior
                break
    [h, l]

[hSessOwn, lSessOwn] = f_prev_nse_session_hl()
[hSess5, lSess5] = request.security(syminfo.tickerid, "5", f_prev_nse_session_hl(), lookahead = barmerge.lookahead_off)
[cSessScan, lSessScan] = f_prev_session_close_low()
[cSess5, lSess5cl] = request.security(syminfo.tickerid, "5", f_prev_session_close_low(), lookahead = barmerge.lookahead_off)
[hDayOwn, lDayOwn] = f_prior_day_hl()
[hOrOwn, lOrOwn] = f_prior_or_hl(930, 1005)
float hDayD = request.security(syminfo.tickerid, "D", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float lDayD = request.security(syminfo.tickerid, "D", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float cDayD = request.security(syminfo.tickerid, "D", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

f_trim_hl(float[] hs, float[] ls, float trimHighPct, float trimLowPct) =>
    float hOut = na
    float lOut = na
    int n = array.size(hs)
    if n > 0
        if (trimHighPct <= 0 and trimLowPct <= 0) or n < 5
            hOut := array.max(hs)
            lOut := array.min(ls)
        else
            float[] hs2 = array.copy(hs)
            float[] ls2 = array.copy(ls)
            array.sort(hs2, order.ascending)
            array.sort(ls2, order.ascending)
            int dropH = trimHighPct <= 0 ? 0 : int(math.floor(n * trimHighPct / 100.0))
            int dropL = trimLowPct <= 0 ? 0 : int(math.floor(n * trimLowPct / 100.0))
            int maxDrop = int(math.floor((n - 1) / 2))
            dropH := math.min(dropH, maxDrop)
            dropL := math.min(dropL, maxDrop)
            hOut := array.get(hs2, n - 1 - dropH)
            lOut := array.get(ls2, dropL)
    [hOut, lOut]

// Clock-anchored OR: [orStart, orEnd) e.g. Ext50 => 930-1005
f_collect_or_clock(int orStart, int orEnd, string hSrc, string lSrc, int d0, int m0, int y0, int maxScan) =>
    float[] hs = array.new_float()
    float[] ls = array.new_float()
    int cnt = 0
    int iFrom = na
    int iTo = na
    int dayBars = 0
    for i = 1 to maxScan
        if f_same_day(i, d0, m0, y0)
            dayBars += 1
        else
            break
    if dayBars > 0
        for i = dayBars to 1
            int t = f_hhmm(i)
            if t >= orStart and t < orEnd
                array.push(hs, f_pick_h(i, hSrc))
                array.push(ls, f_pick_l(i, lSrc))
                cnt += 1
                if cnt == 1
                    iFrom := i
                iTo := i
    [hs, ls, cnt, iFrom, iTo]

f_collect_first(int len, int startHhmm, string hSrc, string lSrc, int d0, int m0, int y0, int maxScan) =>
    float[] hs = array.new_float()
    float[] ls = array.new_float()
    int cnt = 0
    int iFrom = na
    int iTo = na
    int dayBars = 0
    for i = 1 to maxScan
        if f_same_day(i, d0, m0, y0)
            dayBars += 1
        else
            break
    if dayBars > 0
        for i = dayBars to 1
            if f_hhmm(i) >= startHhmm
                array.push(hs, f_pick_h(i, hSrc))
                array.push(ls, f_pick_l(i, lSrc))
                cnt += 1
                if cnt == 1
                    iFrom := i
                iTo := i
                if cnt >= len
                    break
    [hs, ls, cnt, iFrom, iTo]

f_collect_last(int len, int startHhmm, int lag, string hSrc, string lSrc, int d0, int m0, int y0, int maxScan) =>
    float[] hs = array.new_float()
    float[] ls = array.new_float()
    int cnt = 0
    int iFrom = na
    int iTo = na
    int iStart = lag + 1
    for i = iStart to maxScan
        if cnt >= len
            break
        if f_same_day(i, d0, m0, y0) and f_hhmm(i) >= startHhmm
            array.push(hs, f_pick_h(i, hSrc))
            array.push(ls, f_pick_l(i, lSrc))
            cnt += 1
            if cnt == 1
                iTo := i
            iFrom := i
        else if not f_same_day(i, d0, m0, y0)
            break
    [hs, ls, cnt, iFrom, iTo]

f_robot_hl(int len, int startHhmm, int orSkip, string mode, string hSrc, string lSrc, int manualLag, float trimHighPct, float trimLowPct) =>
    float h = na
    float l = na
    int cnt = 0
    int iFrom = na
    int iTo = na
    int usedLag = 0
    string branch = "-"
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    int maxScan = math.min(bar_index, 5000)

    if mode == "Auto OR-Last" and len >= 60
        branch := "last"
        usedLag := 0
        [hsA, lsA, cA, fA, tA] = f_collect_last(len, startHhmm, 0, hSrc, lSrc, d0, m0, y0, maxScan)
        [hA, lA] = f_trim_hl(hsA, lsA, trimHighPct, trimLowPct)
        h := hA
        l := lA
        cnt := cA
        iFrom := fA
        iTo := tA
    else if mode == "Auto OR-Last"
        // Clock OR: Start+Skip .. Start+Extend — Ext50 => 930-1005 int math
        int orStart = f_add_mins(startHhmm, orSkip)
        int orEnd = f_add_mins(startHhmm, len)
        branch := "or" + str.tostring(orStart) + "-" + str.tostring(orEnd)
        usedLag := 0
        [hsB, lsB, cB, fB, tB] = f_collect_or_clock(orStart, orEnd, hSrc, lSrc, d0, m0, y0, maxScan)
        [hB, lB] = f_trim_hl(hsB, lsB, 0.0, 0.0)
        h := hB
        l := lB
        cnt := cB
        iFrom := fB
        iTo := tB
    else if mode == "Last Ext bars"
        branch := "last"
        usedLag := manualLag
        [hsC, lsC, cC, fC, tC] = f_collect_last(len, startHhmm, manualLag, hSrc, lSrc, d0, m0, y0, maxScan)
        [hC, lC] = f_trim_hl(hsC, lsC, trimHighPct, trimLowPct)
        h := hC
        l := lC
        cnt := cC
        iFrom := fC
        iTo := tC
    else if mode == "Offset Ext to 2Ext"
        branch := "offset"
        usedLag := len
        float[] hsO = array.new_float()
        float[] lsO = array.new_float()
        iFrom := len
        iTo := 2 * len - 1
        if iFrom <= bar_index
            int iEnd = math.min(iTo, bar_index)
            for i = iFrom to iEnd
                if f_same_day(i, d0, m0, y0) and f_hhmm(i) >= startHhmm
                    array.push(hsO, f_pick_h(i, hSrc))
                    array.push(lsO, f_pick_l(i, lSrc))
                    cnt += 1
                    if na(iTo) or i < iTo
                        iTo := i
                    if na(iFrom) or i > iFrom
                        iFrom := i
        [hO, lO] = f_trim_hl(hsO, lsO, trimHighPct, trimLowPct)
        h := hO
        l := lO
    else
        branch := "first"
        usedLag := 0
        [hsD, lsD, cD, fD, tD] = f_collect_first(len, startHhmm, hSrc, lSrc, d0, m0, y0, maxScan)
        [hD, lD] = f_trim_hl(hsD, lsD, 0.0, 0.0)
        h := hD
        l := lD
        cnt := cD
        iFrom := fD
        iTo := tD
    [h, l, cnt, iFrom, iTo, usedLag, branch]

[hRob, lRob, nRob, i0, i1, lagUsed, winBranch] = f_robot_hl(extendIn, robotStartHhmm, robotOrSkipMins, robotMode, robotHSource, robotLSource, robotLagManual, robotTrimHighPct, robotTrimLowPct)

// INDIAN H/L pick — Target 1 equals these anchors; ratios build the rest
float indianH = na
float indianL = na
if indianHlSrc == "Manual Target 1" and i_manH > i_manL and i_manL > 0
    indianH := i_manH
    indianL := i_manL
else if indianHlSrc == "Prev Close + Prev Low (chart)"
    indianH := na(cSessScan) ? cSess5 : cSessScan
    indianL := na(lSessScan) ? lSess5cl : lSessScan
else if indianHlSrc == "Prev Close + Prev Low (Daily)"
    indianH := cDayD
    indianL := lDayD
else if indianHlSrc == "Prev NSE session 5m High/Low"
    indianH := hSess5
    indianL := lSess5
else if indianHlSrc == "Prior day OR 0930-1005"
    indianH := hOrOwn
    indianL := lOrOwn
else if indianHlSrc == "Chart TF calendar High/Low"
    indianH := hDayOwn
    indianL := lDayOwn
else if indianHlSrc == "Daily High/Low series"
    indianH := hDayD
    indianL := lDayD
else
    // Prev NSE session High/Low
    indianH := hSessOwn
    indianL := lSessOwn

// Fallbacks if chosen source empty
if na(indianH) or na(indianL) or indianH <= indianL
    indianH := na(cSessScan) ? cDayD : cSessScan
    indianL := na(lSessScan) ? lDayD : lSessScan
if na(indianH) or na(indianL) or indianH <= indianL
    indianH := na(hSessOwn) ? hSess5 : hSessOwn
    indianL := na(lSessOwn) ? lSess5 : lSessOwn
if na(indianH) or na(indianL) or indianH <= indianL
    indianH := hDayOwn
    indianL := lDayOwn
if (na(indianH) or na(indianL) or indianH <= indianL) and i_manH > i_manL and i_manL > 0
    indianH := i_manH
    indianL := i_manL

rawH = isIndian ? indianH : hRob
rawL = isIndian ? indianL : lRob
liveC = (rawH + rawL) / 2.0
liveB = (rawH - rawL) / 2.0

var float frozenC = na
var float frozenB = na
var float frozenH = na
var float frozenL = na
var string frozenSeg = "INIT"
var int frozenDate = -1
var int frozenSrc = -1
var int frozenForce = -1
var int frozenDayKey = -1
var float frozenManH = na
var float frozenManL = na

srcFlag = indianHlSrc == "Manual Target 1" ? 7 : indianHlSrc == "Prev Close + Prev Low (chart)" ? 6 : indianHlSrc == "Prev Close + Prev Low (Daily)" ? 5 : indianHlSrc == "Prev NSE session 5m High/Low" ? 4 : indianHlSrc == "Prior day OR 0930-1005" ? 3 : indianHlSrc == "Chart TF calendar High/Low" ? 2 : indianHlSrc == "Daily High/Low series" ? 1 : 0
forceFlag = forceRecalc ? 1 : 0
dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
hlDrift = not na(frozenH) and not na(rawH) and (math.abs(frozenH - rawH) > syminfo.mintick or math.abs(frozenL - rawL) > syminfo.mintick)
manDrift = indianHlSrc == "Manual Target 1" and (frozenManH != i_manH or frozenManL != i_manL)
indianChanged = segment != frozenSeg or anchorDate != frozenDate or srcFlag != frozenSrc or forceFlag != frozenForce or dayKey != frozenDayKey or hlDrift or manDrift
canSnapIndian = enableLevels and isIndian and barstate.islast and not na(liveC) and not na(liveB) and liveB > 0
if canSnapIndian and (indianChanged or na(frozenC))
    frozenC := liveC
    frozenB := liveB
    frozenH := rawH
    frozenL := rawL
    frozenSeg := segment
    frozenDate := anchorDate
    frozenSrc := srcFlag
    frozenForce := forceFlag
    frozenDayKey := dayKey
    frozenManH := i_manH
    frozenManL := i_manL

C = isRobot ? liveC : frozenC
B = isRobot ? liveB : frozenB
dispH = isRobot ? rawH : frozenH
dispL = isRobot ? rawL : frozenL

decHi = C + deciderFrac * B
decLo = C - deciderFrac * B
upT1 = C + t1Ratio * B
upT2 = C + t2Ratio * B
upT3 = C + t3Ratio * B
upT4 = C + t4Ratio * B
dnT1 = C - t1Ratio * B
dnT2 = C - t2Ratio * B
dnT3 = C - t3Ratio * B
dnT4 = C - t4Ratio * B

var line[] lines = array.new_line()
var label[] labels = array.new_label()

f_clear() =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

f_level(float price, string txt, color lineCol, bool showLine) =>
    if not na(price) and showLine
        int x1 = isRobot ? bar_index - robotLineLeft : bar_index - indianLineLeft
        int x2 = isRobot ? bar_index + robotLineRight : bar_index + indianRight
        extMode = isIndian and indianExtendRight ? extend.right : extend.none
        line ln = line.new(x1, price, x2, price, xloc = xloc.bar_index, extend = extMode, color = lineCol, style = line.style_dashed, width = lineWidth)
        array.push(lines, ln)
        if showLabels
            int lx = isIndian and indianExtendRight ? bar_index + 2 : x2
            label lb = label.new(lx, price, txt + " / " + str.tostring(price, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(lineCol, 85), textcolor = lineCol, size = size.small)
            array.push(labels, lb)

if barstate.islast and enableLevels and not na(C) and not na(B) and B > 0
    f_clear()
    if showDecider
        f_level(decHi, "Decider", clrDecider, true)
        f_level(decLo, "Decider", clrDecider, true)
    if showCenter
        f_level(C, "Centre", clrCenter, true)
    if showUpTgts
        f_level(upT1, "Target 1", clrT1, true)
        f_level(upT2, "Target 2", clrT2, true)
        f_level(upT3, "Target 3", clrT3, true)
        f_level(upT4, "Target 4", clrT4, true)
    if showDnTgts
        f_level(dnT1, "Target 1", clrT1, true)
        f_level(dnT2, "Target 2", clrT2, true)
        f_level(dnT3, "Target 3", clrT3, true)
        f_level(dnT4, "Target 4", clrT4, true)

bgcolor(color.new(color.black, 100))
plot(close, title = "seed", display = display.none)

plotH = enableLevels and showPlots ? dispH : na
plotL = enableLevels and showPlots ? dispL : na
plotC = enableLevels and showPlots ? C : na
plotB = enableLevels and showPlots ? B : na
plotDecHi = enableLevels and showPlots and showDecider ? decHi : na
plotDecLo = enableLevels and showPlots and showDecider ? decLo : na
plotUT1 = enableLevels and showPlots and showUpTgts ? upT1 : na
plotLT1 = enableLevels and showPlots and showDnTgts ? dnT1 : na
plotUT4 = enableLevels and showPlots and showUpTgts ? upT4 : na
plotLT4 = enableLevels and showPlots and showDnTgts ? dnT4 : na

plot(plotH, "Window High", display = display.data_window)
plot(plotL, "Window Low", display = display.data_window)
plot(plotC, "Centre C", color = clrCenter, display = display.data_window)
plot(plotB, "Base B", color = clrCenter, display = display.data_window)
plot(plotDecHi, "Decider High", color = clrDecider, linewidth = 2, style = plot.style_linebr, trackprice = true)
plot(plotDecLo, "Decider Low", color = clrDecider, linewidth = 2, style = plot.style_linebr, trackprice = true)
plot(plotUT1, "Target 1 High", color = clrT1, linewidth = 1, style = plot.style_linebr, trackprice = true)
plot(plotLT1, "Target 1 Low", color = clrT1, linewidth = 1, style = plot.style_linebr, trackprice = true)
plot(plotUT4, "Target 4 High", color = clrT4, linewidth = 1, style = plot.style_linebr)
plot(plotLT4, "Target 4 Low", color = clrT4, linewidth = 1, style = plot.style_linebr)

var table info = table.new(position.top_right, 2, 16, bgcolor = color.new(color.black, 80), border_width = 0)
if barstate.islast
    segShort = isIndian ? "INDIAN" : "ROBOT"
    table.cell(info, 0, 0, segShort + " Ext " + str.tostring(extendIn), text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, isRobot ? "LIVE" : "FROZEN", text_color = color.aqua, text_size = size.small)
    if isRobot
        t0 = na(i0) ? "-" : str.tostring(f_hhmm(i0))
        t1 = na(i1) ? "-" : str.tostring(f_hhmm(i1))
        table.cell(info, 0, 1, "Window", text_color = color.gray, text_size = size.small)
        table.cell(info, 1, 1, winBranch + " n=" + str.tostring(nRob) + " " + t0 + "-" + t1, text_color = color.aqua, text_size = size.small)
    else
        table.cell(info, 0, 1, "H/L src", text_color = color.gray, text_size = size.small)
        table.cell(info, 1, 1, indianHlSrc, text_color = color.aqua, text_size = size.small)
    table.cell(info, 0, 2, "H / L = T1", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 2, na(dispH) ? "Waiting..." : str.tostring(dispH, format.mintick) + " / " + str.tostring(dispL, format.mintick), text_color = color.silver, text_size = size.small)
    table.cell(info, 0, 3, "C / B", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 3, na(C) ? "..." : str.tostring(C, format.mintick) + " / " + str.tostring(B, format.mintick), text_color = color.yellow, text_size = size.small)
    table.cell(info, 0, 4, "Decider", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 4, na(decHi) ? "" : str.tostring(decHi, format.mintick) + " / " + str.tostring(decLo, format.mintick), text_color = clrDecider, text_size = size.small)
    table.cell(info, 0, 5, "Target 1", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 5, na(upT1) ? "" : str.tostring(upT1, format.mintick) + " / " + str.tostring(dnT1, format.mintick), text_color = clrT1, text_size = size.small)
    table.cell(info, 0, 6, "Target 2", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 6, na(upT2) ? "" : str.tostring(upT2, format.mintick) + " / " + str.tostring(dnT2, format.mintick), text_color = clrT2, text_size = size.small)
    table.cell(info, 0, 7, "Target 3", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 7, na(upT3) ? "" : str.tostring(upT3, format.mintick) + " / " + str.tostring(dnT3, format.mintick), text_color = clrT3, text_size = size.small)
    table.cell(info, 0, 8, "Target 4", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 8, na(upT4) ? "" : str.tostring(upT4, format.mintick) + " / " + str.tostring(dnT4, format.mintick), text_color = clrT4, text_size = size.small)
    if i_showHlDbg and isIndian
        table.cell(info, 0, 9, "dbg Close/Low chart", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 9, na(cSessScan) ? "-" : str.tostring(cSessScan, format.mintick) + " / " + str.tostring(lSessScan, format.mintick), text_color = color.lime, text_size = size.tiny)
        table.cell(info, 0, 10, "dbg Close/Low Daily", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 10, na(cDayD) ? "-" : str.tostring(cDayD, format.mintick) + " / " + str.tostring(lDayD, format.mintick), text_color = color.olive, text_size = size.tiny)
        table.cell(info, 0, 11, "dbg High/Low sess", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 11, na(hSessOwn) ? "-" : str.tostring(hSessOwn, format.mintick) + " / " + str.tostring(lSessOwn, format.mintick), text_color = color.orange, text_size = size.tiny)
        table.cell(info, 0, 12, "dbg High/Low 5m", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 12, na(hSess5) ? "-" : str.tostring(hSess5, format.mintick) + " / " + str.tostring(lSess5, format.mintick), text_color = color.gray, text_size = size.tiny)
        table.cell(info, 0, 13, "dbg OR 930-1005", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 13, na(hOrOwn) ? "-" : str.tostring(hOrOwn, format.mintick) + " / " + str.tostring(lOrOwn, format.mintick), text_color = color.gray, text_size = size.tiny)
        table.cell(info, 0, 14, "dbg Daily High/Low", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 14, na(hDayD) ? "-" : str.tostring(hDayD, format.mintick) + " / " + str.tostring(lDayD, format.mintick), text_color = color.gray, text_size = size.tiny)
        table.cell(info, 0, 15, "If mismatch", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 15, "Paste vendor T1 into Manual H/L", text_color = color.aqua, text_size = size.tiny)
