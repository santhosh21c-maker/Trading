//@version=5
// Smart Robotic Logic – Decider & Targets (Educational recreation)
// Recreates CPR-based Decider band + mirrored Target 1–4 levels
// similar to the PxTrading-style options charts (Nifty CE/PE).
//
// How to use:
// 1. Open TradingView → Pine Editor → Paste this script → Add to chart
// 2. Apply on option premium chart (1m recommended)
// 3. Enable "Hybrid (Force 5 Min Values)" to match index-style 5m math on 1m charts
// 4. Adjust "Extend => Length" (50 / 60 / etc.) – this changes Decider & all Targets

indicator("Smart Robotic Logic – Decider & Targets", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
grpRobot     = "Robot Targets"
enableLevels = input.bool(true,  "Enable Automated Levels", group=grpRobot)
lengthIn     = input.int(50,     "Extend => Length", minval=2, maxval=500, group=grpRobot,
     tooltip="Lookback bars used to compute High/Low/Close for CPR (Decider). Changing 50→60 shifts Decider & Targets.")
cprMode      = input.string("Current", "CPR Mode", options=["Current", "Future"], group=grpRobot,
     tooltip="Current = confirmed lookback HLC. Future = developing window (includes forming bar), like Tomorrow CPR.")
hybrid5m     = input.bool(true,  "Hybrid (Force 5 Min Values)", group=grpRobot,
     tooltip="Calculate H/L/C on 5-minute timeframe, then plot on current chart (typical for 1m option charts).")
extendRight  = input.int(30,     "Extend Lines Right (bars)", minval=0, maxval=500, group=grpRobot)
extendLeft   = input.int(80,     "Extend Lines Left (bars)",  minval=0, maxval=500, group=grpRobot)

grpShow      = "Show / Hide"
showDecider  = input.bool(true, "Show Decider",  group=grpShow)
showUpTgts   = input.bool(true, "Show Upper Targets", group=grpShow)
showDnTgts   = input.bool(true, "Show Lower Targets", group=grpShow)
showLabels   = input.bool(true, "Show Labels",   group=grpShow)
showPivotMid = input.bool(false,"Show Pivot (mid)", group=grpShow)

grpMult      = "Target Multipliers (× Range)"
// Defaults reverse-engineered from chart geometry:
// Target distances from Pivot ≈ Range × these factors
// Observed distance ratios T1:T2:T3:T4 ≈ 1 : 1.54 : 1.83 : 2.08
t1Mult = input.float(0.382, "Target 1 × Range", step=0.001, group=grpMult)
t2Mult = input.float(0.588, "Target 2 × Range", step=0.001, group=grpMult)  // ≈ 0.382 × 1.54
t3Mult = input.float(0.699, "Target 3 × Range", step=0.001, group=grpMult)  // ≈ 0.382 × 1.83
t4Mult = input.float(0.795, "Target 4 × Range", step=0.001, group=grpMult)  // ≈ 0.382 × 2.08

grpStyle     = "Colors"
colDecider   = input.color(color.new(#9E9E9E, 0), "Decider",   group=grpStyle)
colT1        = input.color(color.new(#26A69A, 0), "Target 1",  group=grpStyle)
colT2        = input.color(color.new(#FF9800, 0), "Target 2",  group=grpStyle)
colT3        = input.color(color.new(#EC407A, 0), "Target 3",  group=grpStyle)
colT4        = input.color(color.new(#AB47BC, 0), "Target 4",  group=grpStyle)
colPivot     = input.color(color.new(#787B86, 0), "Pivot",     group=grpStyle)
lineWidth    = input.int(1, "Line Width", minval=1, maxval=3, group=grpStyle)

// ═══════════════════════════════════════════════════════════════
// HLC ENGINE (optionally forced to 5-minute)
// ═══════════════════════════════════════════════════════════════
f_hlc(len, mode) =>
    // Current  → exclude forming bar (confirmed window)
    // Future   → include forming bar (developing / "tomorrow" style)
    float h = mode == "Future" ? ta.highest(high, len) : ta.highest(high, len)[1]
    float l = mode == "Future" ? ta.lowest(low, len)  : ta.lowest(low, len)[1]
    float c = mode == "Future" ? close                 : close[1]
    [h, l, c]

[hLtf, lLtf, cLtf] = f_hlc(lengthIn, cprMode)

[h5, l5, c5] = request.security(syminfo.tickerid, "5", f_hlc(lengthIn, cprMode), lookahead=barmerge.lookahead_off)

float useH = hybrid5m ? h5 : hLtf
float useL = hybrid5m ? l5 : lLtf
float useC = hybrid5m ? c5 : cLtf

// ═══════════════════════════════════════════════════════════════
// CPR (DECIDER) + TARGET MATH
// ═══════════════════════════════════════════════════════════════
// Classic Central Pivot Range:
//   Pivot P = (H + L + C) / 3
//   BC      = (H + L) / 2          ← lower Decider
//   TC      = 2P - BC              ← upper Decider
// Targets are mirrored above/below Pivot using Range = H - L

float piv = (useH + useL + useC) / 3.0
float bc  = (useH + useL) / 2.0
float tc  = 2.0 * piv - bc
float rng = useH - useL

float upT1 = piv + rng * t1Mult
float upT2 = piv + rng * t2Mult
float upT3 = piv + rng * t3Mult
float upT4 = piv + rng * t4Mult

float dnT1 = piv - rng * t1Mult
float dnT2 = piv - rng * t2Mult
float dnT3 = piv - rng * t3Mult
float dnT4 = piv - rng * t4Mult

// ═══════════════════════════════════════════════════════════════
// DRAW HELPERS
// ═══════════════════════════════════════════════════════════════
var line[]  lines  = array.new_line()
var label[] labels = array.new_label()

f_clear() =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

f_level(float price, string txt, color col, bool showLine, bool showLab) =>
    if not na(price) and showLine
        int x1 = bar_index - extendLeft
        int x2 = bar_index + extendRight
        line ln = line.new(x1, price, x2, price, xloc=xloc.bar_index, extend=extend.none,
             color=col, style=line.style_dashed, width=lineWidth)
        array.push(lines, ln)
        if showLab and showLabels
            label lb = label.new(x2, price, txt + " / " + str.tostring(price, format.mintick),
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left,
                 color=color.new(col, 85), textcolor=col, size=size.small)
            array.push(labels, lb)

// ═══════════════════════════════════════════════════════════════
// RENDER (update on last bar only)
// ═══════════════════════════════════════════════════════════════
if barstate.islast and enableLevels and not na(piv) and rng > 0
    f_clear()

    // Decider band (CPR TC / BC)
    if showDecider
        f_level(tc, "💔 Decider", colDecider, true, true)
        f_level(bc, "💔 Decider", colDecider, true, true)

    if showPivotMid
        f_level(piv, "Pivot", colPivot, true, true)

    // Upper targets
    if showUpTgts
        f_level(upT1, "😇 Target 1", colT1, true, true)
        f_level(upT2, "🔥 Target 2", colT2, true, true)
        f_level(upT3, "🏹 Target 3", colT3, true, true)
        f_level(upT4, "👿 Target 4", colT4, true, true)

    // Lower targets
    if showDnTgts
        f_level(dnT1, "😇 Target 1", colT1, true, true)
        f_level(dnT2, "🔥 Target 2", colT2, true, true)
        f_level(dnT3, "🏹 Target 3", colT3, true, true)
        f_level(dnT4, "👿 Target 4", colT4, true, true)

// ═══════════════════════════════════════════════════════════════
// OPTIONAL: expose values in Data Window / status line
// ═══════════════════════════════════════════════════════════════
plot(enableLevels and showDecider ? tc : na, "Decider TC", color=colDecider, display=display.data_window)
plot(enableLevels and showDecider ? bc : na, "Decider BC", color=colDecider, display=display.data_window)
plot(enableLevels ? piv : na, "Pivot", color=colPivot, display=display.data_window)
plot(enableLevels and showUpTgts ? upT1 : na, "Up Target 1", color=colT1, display=display.data_window)
plot(enableLevels and showUpTgts ? upT2 : na, "Up Target 2", color=colT2, display=display.data_window)
plot(enableLevels and showUpTgts ? upT3 : na, "Up Target 3", color=colT3, display=display.data_window)
plot(enableLevels and showUpTgts ? upT4 : na, "Up Target 4", color=colT4, display=display.data_window)
plot(enableLevels and showDnTgts ? dnT1 : na, "Dn Target 1", color=colT1, display=display.data_window)
plot(enableLevels and showDnTgts ? dnT2 : na, "Dn Target 2", color=colT2, display=display.data_window)
plot(enableLevels and showDnTgts ? dnT3 : na, "Dn Target 3", color=colT3, display=display.data_window)
plot(enableLevels and showDnTgts ? dnT4 : na, "Dn Target 4", color=colT4, display=display.data_window)

// Tiny status so you can confirm Length / Hybrid on the chart
var table info = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 80), border_width=0)
if barstate.islast
    string modeTxt = (hybrid5m ? "5m Hybrid" : syminfo.period) + " | Len " + str.tostring(lengthIn) + " | " + cprMode
    table.cell(info, 0, 0, modeTxt, text_color=color.white, text_size=size.small)
