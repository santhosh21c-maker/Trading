//@version=5
// Smart Robotic Logic – Decider & Targets (Educational recreation)
//
// Corrected model (cross-checked against chart arithmetic):
//   C  = ladder centre (default: pivot of lookback H/L/C)
//   B  = ladder base step (default: Range × base fraction)
//   Decider  = C ± 0.06·B          ← NOT a CPR TC/BC band
//   Target N = C ± ratioN·B        ← ratios ≈ 1 : 1.54 : 1.83 : 2.08
//
// Why CPR was wrong for the gap:
//   CPR width = (2C − H − L)/3 varies with where Close sits in the range
//   (often ~3–14% of range). Your Decider gaps are a fixed 0.12·B on
//   both Call and Put — that only fits C ± 0.06·B, not TC/BC.
//
// How to use:
// 1. TradingView → Pine Editor → Paste → Add to chart
// 2. Option premium chart (1m recommended), Hybrid 5m ON
// 3. Change Length 50→60 to see C/B (and all levels) shift

indicator("Smart Robotic Logic – Decider & Targets", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
grpRobot     = "Robot Targets"
enableLevels = input.bool(true,  "Enable Automated Levels", group=grpRobot)
lengthIn     = input.int(50,     "Extend => Length", minval=2, maxval=500, group=grpRobot,
     tooltip="Lookback bars for H/L/C used to build centre C and base B. 50→60 shifts Decider & Targets.")
winMode      = input.string("Current", "Window Mode", options=["Current", "Future"], group=grpRobot,
     tooltip="Current = confirmed lookback (excludes forming bar). Future = developing window.")
centerMode   = input.string("Pivot (H+L+C)/3", "Centre C source",
     options=["Pivot (H+L+C)/3", "Close", "HL2 (H+L)/2", "HLC3"], group=grpRobot,
     tooltip="Midpoint of the Decider band. Pivot remains a live hypothesis; switch if levels don't match.")
baseMode     = input.string("Range × Fraction", "Base B source",
     options=["Range × Fraction", "ATR"], group=grpRobot)
baseFrac     = input.float(0.382, "Base B = Range ×", step=0.001, group=grpRobot,
     tooltip="Used when Base B source = Range × Fraction. B becomes Target-1 distance.")
atrLen       = input.int(14, "ATR Length (if ATR base)", minval=1, group=grpRobot)
hybrid5m     = input.bool(true,  "Hybrid (Force 5 Min Values)", group=grpRobot,
     tooltip="Calculate on 5-minute timeframe, plot on current chart.")
extendRight  = input.int(30, "Extend Lines Right (bars)", minval=0, maxval=500, group=grpRobot)
extendLeft   = input.int(80, "Extend Lines Left (bars)",  minval=0, maxval=500, group=grpRobot)

grpShow      = "Show / Hide"
showDecider  = input.bool(true,  "Show Decider", group=grpShow)
showUpTgts   = input.bool(true,  "Show Upper Targets", group=grpShow)
showDnTgts   = input.bool(true,  "Show Lower Targets", group=grpShow)
showLabels   = input.bool(true,  "Show Labels", group=grpShow)
showCenter   = input.bool(false, "Show Centre C", group=grpShow)

grpLadder    = "Ladder (× Base B)"
// Decider half-gap = 0.06·B  →  full Decider gap = 0.12·B  (measured on your charts)
deciderFrac  = input.float(0.06, "Decider ± × B", step=0.001, group=grpLadder,
     tooltip="Deciders are C ± this×B. Gap between the two Decider lines = 2 × this × B = 0.12B at default.")
// Observed Target distance ratios from centre: 1 : 1.54 : 1.83 : 2.08
t1Ratio      = input.float(1.00, "Target 1 × B", step=0.01, group=grpLadder)
t2Ratio      = input.float(1.54, "Target 2 × B", step=0.01, group=grpLadder)
t3Ratio      = input.float(1.83, "Target 3 × B", step=0.01, group=grpLadder)
t4Ratio      = input.float(2.08, "Target 4 × B", step=0.01, group=grpLadder)

grpStyle     = "Colors"
colDecider   = input.color(color.new(#9E9E9E, 0), "Decider",  group=grpStyle)
colT1        = input.color(color.new(#26A69A, 0), "Target 1", group=grpStyle)
colT2        = input.color(color.new(#FF9800, 0), "Target 2", group=grpStyle)
colT3        = input.color(color.new(#EC407A, 0), "Target 3", group=grpStyle)
colT4        = input.color(color.new(#AB47BC, 0), "Target 4", group=grpStyle)
colCenter    = input.color(color.new(#787B86, 0), "Centre",   group=grpStyle)
lineWidth    = input.int(1, "Line Width", minval=1, maxval=3, group=grpStyle)

// ═══════════════════════════════════════════════════════════════
// LOOKBACK H / L / C  (optional Hybrid → 5 minute)
// ═══════════════════════════════════════════════════════════════
f_hlc(int len, string mode) =>
    float h = mode == "Future" ? ta.highest(high, len) : ta.highest(high, len)[1]
    float l = mode == "Future" ? ta.lowest(low, len)  : ta.lowest(low, len)[1]
    float c = mode == "Future" ? close                 : close[1]
    [h, l, c]

f_atr(int len, string mode) =>
    mode == "Future" ? ta.atr(len) : ta.atr(len)[1]

[hLtf, lLtf, cLtf] = f_hlc(lengthIn, winMode)
atrLtf = f_atr(atrLen, winMode)

[h5, l5, c5] = request.security(syminfo.tickerid, "5", f_hlc(lengthIn, winMode), lookahead=barmerge.lookahead_off)
atr5         = request.security(syminfo.tickerid, "5", f_atr(atrLen, winMode), lookahead=barmerge.lookahead_off)

float useH   = hybrid5m ? h5    : hLtf
float useL   = hybrid5m ? l5    : lLtf
float useCl  = hybrid5m ? c5    : cLtf
float useAtr = hybrid5m ? atr5  : atrLtf
float useRng = useH - useL

// ═══════════════════════════════════════════════════════════════
// LADDER MATH:  C, B, Decider, Targets
// ═══════════════════════════════════════════════════════════════
f_center(float h, float l, float c, string mode) =>
    switch mode
        "Close"           => c
        "HL2 (H+L)/2"     => (h + l) / 2.0
        "HLC3"            => (h + l + c) / 3.0
        => (h + l + c) / 3.0   // Pivot default

float C = f_center(useH, useL, useCl, centerMode)
float B = baseMode == "ATR" ? useAtr : useRng * baseFrac

float decHi = C + deciderFrac * B
float decLo = C - deciderFrac * B

float upT1 = C + t1Ratio * B
float upT2 = C + t2Ratio * B
float upT3 = C + t3Ratio * B
float upT4 = C + t4Ratio * B

float dnT1 = C - t1Ratio * B
float dnT2 = C - t2Ratio * B
float dnT3 = C - t3Ratio * B
float dnT4 = C - t4Ratio * B

// ═══════════════════════════════════════════════════════════════
// DRAW HELPERS
// ═══════════════════════════════════════════════════════════════
var line[]  lines  = array.new_line()
var label[] labels = array.new_label()

f_clear() =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

f_level(float price, string txt, color col, bool showLine) =>
    if not na(price) and showLine
        int x1 = bar_index - extendLeft
        int x2 = bar_index + extendRight
        line ln = line.new(x1, price, x2, price, xloc=xloc.bar_index, extend=extend.none,
             color=col, style=line.style_dashed, width=lineWidth)
        array.push(lines, ln)
        if showLabels
            label lb = label.new(x2, price, txt + " / " + str.tostring(price, format.mintick),
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left,
                 color=color.new(col, 85), textcolor=col, size=size.small)
            array.push(labels, lb)

// ═══════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════
if barstate.islast and enableLevels and not na(C) and not na(B) and B > 0
    f_clear()

    if showDecider
        f_level(decHi, "💔 Decider", colDecider, true)
        f_level(decLo, "💔 Decider", colDecider, true)

    if showCenter
        f_level(C, "Centre", colCenter, true)

    if showUpTgts
        f_level(upT1, "😇 Target 1", colT1, true)
        f_level(upT2, "🔥 Target 2", colT2, true)
        f_level(upT3, "🏹 Target 3", colT3, true)
        f_level(upT4, "👿 Target 4", colT4, true)

    if showDnTgts
        f_level(dnT1, "😇 Target 1", colT1, true)
        f_level(dnT2, "🔥 Target 2", colT2, true)
        f_level(dnT3, "🏹 Target 3", colT3, true)
        f_level(dnT4, "👿 Target 4", colT4, true)

// Data Window
plot(enableLevels and showDecider ? decHi : na, "Decider High", color=colDecider, display=display.data_window)
plot(enableLevels and showDecider ? decLo : na, "Decider Low",  color=colDecider, display=display.data_window)
plot(enableLevels ? C : na, "Centre C", color=colCenter, display=display.data_window)
plot(enableLevels ? B : na, "Base B",   color=colCenter, display=display.data_window)
plot(enableLevels and showUpTgts ? upT1 : na, "Up Target 1", color=colT1, display=display.data_window)
plot(enableLevels and showUpTgts ? upT2 : na, "Up Target 2", color=colT2, display=display.data_window)
plot(enableLevels and showUpTgts ? upT3 : na, "Up Target 3", color=colT3, display=display.data_window)
plot(enableLevels and showUpTgts ? upT4 : na, "Up Target 4", color=colT4, display=display.data_window)
plot(enableLevels and showDnTgts ? dnT1 : na, "Dn Target 1", color=colT1, display=display.data_window)
plot(enableLevels and showDnTgts ? dnT2 : na, "Dn Target 2", color=colT2, display=display.data_window)
plot(enableLevels and showDnTgts ? dnT3 : na, "Dn Target 3", color=colT3, display=display.data_window)
plot(enableLevels and showDnTgts ? dnT4 : na, "Dn Target 4", color=colT4, display=display.data_window)

// Status chip (fixed: timeframe.period, not syminfo.period)
var table info = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 80), border_width=0)
if barstate.islast
    string tfTxt = hybrid5m ? "5m Hybrid" : timeframe.period
    string modeTxt = tfTxt + " | Len " + str.tostring(lengthIn) + " | " + winMode
    table.cell(info, 0, 0, modeTxt, text_color=color.white, text_size=size.small)
