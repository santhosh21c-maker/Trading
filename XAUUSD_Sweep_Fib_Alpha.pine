//@version=5
indicator("XAUUSD Sweep Fib Alpha", overlay=true, max_boxes_count=50, max_lines_count=50, max_labels_count=50)

// Educational recreation inspired by TW Alpha Sweep + Fib style setups on XAUUSD.
// Inferred from screenshots 1m vs 5m ACTIVE BUY levels:
//   1m: Entry/SL/TP spaced exactly MinSL 3.5  => risk hit floor
//   5m: Entry 4388.85 SL 4384.04 => R=4.81 in MinSL..MaxSL, TPs at 1R 2R 3R
//   Fib 0.50-0.60 from 15m swings; bias from 15m; execution on chart TF 1m/5m
//
// ASSUMPTIONS documented in README_XAUUSD.md — tune inputs to match live stream.

symOk = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD")
if barstate.isfirst and not symOk
    runtime.error("This indicator is intended for XAUUSD / Gold only.")

grpEntry = "Entry Engine"
i_mode = input.string("Sweep + Fib", "Entry Mode", options=["Sweep + Fib"], group=grpEntry)
i_allow1 = input.bool(true, "Allow 1M", group=grpEntry)
i_allow5 = input.bool(true, "Allow 5M", group=grpEntry)
i_needReject = input.bool(true, "Require Rejection", group=grpEntry)

grpLiq = "Liquidity"
i_liqLb = input.int(10, "Liquidity Lookback", minval=3, maxval=50, group=grpLiq)
i_useEq = input.bool(true, "Use Equal High / Low", group=grpLiq)
i_eqTol = input.float(0.30, "Equal HL tolerance $", minval=0.0, step=0.05, group=grpLiq)
i_sweepBars = input.int(8, "Sweep memory bars", minval=2, maxval=50, group=grpLiq)

grpFib = "15M Fib"
i_fibTf = input.timeframe("15", "Fib Timeframe", group=grpFib)
i_swingLen = input.int(5, "15M Swing Strength", minval=2, maxval=20, group=grpFib)
i_fibStart = input.float(0.512, "Fib Start", minval=0.1, maxval=0.9, step=0.001, group=grpFib)
i_fibEnd = input.float(0.600, "Fib End", minval=0.1, maxval=0.9, step=0.001, group=grpFib)
i_showZone = input.bool(true, "Show 0.50-0.60 Zone", group=grpFib)
i_fibTouchBars = input.int(30, "Fib READY memory bars", minval=5, maxval=200, group=grpFib)

grpBias = "15M Bias"
i_biasMode = input.string("Structure", "Bias Mode", options=["Structure", "EMA", "Close vs Mid"], group=grpBias)
i_emaLen = input.int(50, "Bias EMA length", minval=5, group=grpBias)

grpRisk = "Risk"
i_minSl = input.float(3.5, "Minimum SL $", minval=0.5, step=0.1, group=grpRisk)
i_maxSl = input.float(7.0, "Maximum SL $", minval=1.0, step=0.1, group=grpRisk)
i_tp1 = input.float(1.0, "TP1 R", minval=0.5, step=0.5, group=grpRisk)
i_tp2 = input.float(2.0, "TP2 R", minval=0.5, step=0.5, group=grpRisk)
i_tp3 = input.float(3.0, "TP3 R", minval=0.5, step=0.5, group=grpRisk)
i_slBuf = input.float(0.10, "SL buffer beyond sweep $", minval=0.0, step=0.05, group=grpRisk)

grpShow = "Display"
i_showDash = input.bool(true, "Show dashboard", group=grpShow)
i_showSig = input.bool(true, "Show BUY/SELL labels", group=grpShow)
i_showLvls = input.bool(true, "Show Entry SL TP lines", group=grpShow)
i_oneTrade = input.bool(true, "One active setup at a time", group=grpShow)

c_buy = color.rgb(38, 166, 154)
c_sell = color.rgb(239, 83, 80)
c_entry = color.rgb(33, 150, 243)
c_sl = color.rgb(244, 67, 54)
c_tp = color.rgb(76, 175, 80)
c_zone = color.rgb(255, 235, 59)
c_sweep = color.rgb(233, 30, 99)

// --- helpers ---
f_pivot_high(src, left) =>
    ta.pivothigh(src, left, left)

f_pivot_low(src, left) =>
    ta.pivotlow(src, left, left)

f_eq_low(lb, tol) =>
    float lvl = ta.lowest(low, lb)[1]
    int hits = 0
    for i = 1 to lb
        if math.abs(low[i] - lvl) <= tol
            hits += 1
    [lvl, hits >= 2]

f_eq_high(lb, tol) =>
    float lvl = ta.highest(high, lb)[1]
    int hits = 0
    for i = 1 to lb
        if math.abs(high[i] - lvl) <= tol
            hits += 1
    [lvl, hits >= 2]

f_clamp(v, lo, hi) =>
    math.max(lo, math.min(hi, v))

// --- chart TF allowed? ---
tfOk = timeframe.isminutes and ((timeframe.multiplier == 1 and i_allow1) or (timeframe.multiplier == 5 and i_allow5) or (timeframe.multiplier != 1 and timeframe.multiplier != 5))

// --- 15m swing / fib / bias via request.security ---
f_htf_bundle() =>
    ph = f_pivot_high(high, i_swingLen)
    pl = f_pivot_low(low, i_swingLen)
    var float lastPh = na
    var float lastPl = na
    var int lastPhBar = na
    var int lastPlBar = na
    if not na(ph)
        lastPh := ph
        lastPhBar := bar_index - i_swingLen
    if not na(pl)
        lastPl := pl
        lastPlBar := bar_index - i_swingLen
    float sh = lastPh
    float sl = lastPl
    float rng = not na(sh) and not na(sl) ? math.abs(sh - sl) : na
    // Bias structure: most recent pivot type + price vs mid
    float mid = not na(sh) and not na(sl) ? (sh + sl) * 0.5 : na
    int bias = 0
    if i_biasMode == "EMA"
        ema = ta.ema(close, i_emaLen)
        bias := close > ema ? 1 : close < ema ? -1 : 0
    else if i_biasMode == "Close vs Mid"
        bias := not na(mid) ? (close > mid ? 1 : close < mid ? -1 : 0) : 0
    else
        // Structure: if last pivot low is newer than last pivot high => upswing forming / bullish preference when close > mid
        newerLow = not na(lastPlBar) and (na(lastPhBar) or lastPlBar > lastPhBar)
        newerHigh = not na(lastPhBar) and (na(lastPlBar) or lastPhBar > lastPlBar)
        if newerLow and not na(mid)
            bias := close >= mid ? 1 : -1
        else if newerHigh and not na(mid)
            bias := close <= mid ? -1 : 1
        else if not na(mid)
            bias := close > mid ? 1 : -1
    // Fib zone for bullish impulse (sl then sh): retracement from high
    // For bearish impulse (sh then sl): retracement from low
    float fibHi = na
    float fibLo = na
    bullLeg = not na(lastPhBar) and not na(lastPlBar) and lastPlBar < lastPhBar and not na(rng) and rng > 0
    bearLeg = not na(lastPhBar) and not na(lastPlBar) and lastPhBar < lastPlBar and not na(rng) and rng > 0
    if bullLeg
        // buy discount zone below high
        a = math.min(i_fibStart, i_fibEnd)
        b = math.max(i_fibStart, i_fibEnd)
        fibHi := sh - rng * a
        fibLo := sh - rng * b
    else if bearLeg
        a = math.min(i_fibStart, i_fibEnd)
        b = math.max(i_fibStart, i_fibEnd)
        fibLo := sl + rng * a
        fibHi := sl + rng * b
    [bias, sh, sl, fibHi, fibLo, bullLeg, bearLeg, mid]

[htfBias, htfSh, htfSl, htfFibHi, htfFibLo, htfBullLeg, htfBearLeg, htfMid] = request.security(syminfo.tickerid, i_fibTf, f_htf_bundle(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

biasBull = htfBias == 1
biasBear = htfBias == -1

inFibZone = not na(htfFibHi) and not na(htfFibLo) and high >= htfFibLo and low <= htfFibHi
var int lastFibTouch = na
if inFibZone
    lastFibTouch := bar_index
fibReady = not na(lastFibTouch) and (bar_index - lastFibTouch) <= i_fibTouchBars

// --- liquidity sweeps on chart TF ---
eqLowPack = f_eq_low(i_liqLb, i_eqTol)
eqHighPack = f_eq_high(i_liqLb, i_eqTol)
eqLow = eqLowPack[0]
eqHigh = eqHighPack[0]
haveEqLow = i_useEq ? eqLowPack[1] : true
haveEqHigh = i_useEq ? eqHighPack[1] : true

swingLow = ta.lowest(low, i_liqLb)[1]
swingHigh = ta.highest(high, i_liqLb)[1]
liqLow = i_useEq and haveEqLow ? eqLow : swingLow
liqHigh = i_useEq and haveEqHigh ? eqHigh : swingHigh

// Bear sweep = take liquidity below lows then reclaim close above — sets up BUY
bearSweep = not na(liqLow) and low < liqLow and close > liqLow and haveEqLow
// Bull sweep = take liquidity above highs then close back below — sets up SELL
bullSweep = not na(liqHigh) and high > liqHigh and close < liqHigh and haveEqHigh

var int lastBearSweepBar = na
var float lastBearSweepLvl = na
var float lastBearSweepExt = na
var int lastBullSweepBar = na
var float lastBullSweepLvl = na
var float lastBullSweepExt = na

if bearSweep
    lastBearSweepBar := bar_index
    lastBearSweepLvl := liqLow
    lastBearSweepExt := low
if bullSweep
    lastBullSweepBar := bar_index
    lastBullSweepLvl := liqHigh
    lastBullSweepExt := high

bearSweepFresh = not na(lastBearSweepBar) and (bar_index - lastBearSweepBar) <= i_sweepBars
bullSweepFresh = not na(lastBullSweepBar) and (bar_index - lastBullSweepBar) <= i_sweepBars

liqState = bearSweepFresh ? "BEAR SWEEP" : bullSweepFresh ? "BULL SWEEP" : "WAITING"

// --- rejection ---
bullReject = close > open and close > low + (high - low) * 0.6 and low <= nz(lastBearSweepLvl, low)
bearReject = close < open and close < high - (high - low) * 0.6 and high >= nz(lastBullSweepLvl, high)
rejectOkBuy = not i_needReject or bullReject
rejectOkSell = not i_needReject or bearReject

// --- active trade state ---
var int setupDir = 0
var float entryPx = na
var float slPx = na
var float tp1Px = na
var float tp2Px = na
var float tp3Px = na
var int entryBar = na
var bool tp1Hit = false
var bool tp2Hit = false
var bool tp3Hit = false
var bool slHit = false

var int dayTp1 = 0
var int dayTp2 = 0
var int dayTp3 = 0
var int daySl = 0
var int dayBuy = 0
var int daySell = 0
var float dayR = 0.0
var int dayId = na

curDay = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")
if na(dayId) or curDay != dayId
    dayId := curDay
    dayTp1 := 0
    dayTp2 := 0
    dayTp3 := 0
    daySl := 0
    dayBuy := 0
    daySell := 0
    dayR := 0.0

// BUY: 15m bullish + fib ready + recent bear sweep + rejection
buySignal = tfOk and biasBull and fibReady and bearSweepFresh and rejectOkBuy and (not i_oneTrade or setupDir == 0)
// SELL: 15m bearish + fib ready + recent bull sweep + rejection
sellSignal = tfOk and biasBear and fibReady and bullSweepFresh and rejectOkSell and (not i_oneTrade or setupDir == 0)

buyNow = buySignal and (bearSweep or bullReject or not i_needReject)
sellNow = sellSignal and (bullSweep or bearReject or not i_needReject)

if buyNow and (setupDir == 0 or not i_oneTrade)
    float sweepExt = nz(lastBearSweepExt, low)
    float rawRisk = close - sweepExt + i_slBuf
    float risk = f_clamp(rawRisk, i_minSl, i_maxSl)
    // If structural risk beyond max, skip
    if rawRisk <= i_maxSl + i_slBuf
        setupDir := 1
        entryPx := close
        slPx := entryPx - risk
        tp1Px := entryPx + risk * i_tp1
        tp2Px := entryPx + risk * i_tp2
        tp3Px := entryPx + risk * i_tp3
        entryBar := bar_index
        tp1Hit := false
        tp2Hit := false
        tp3Hit := false
        slHit := false
        dayBuy += 1

if sellNow and (setupDir == 0 or not i_oneTrade)
    float sweepExt = nz(lastBullSweepExt, high)
    float rawRisk = sweepExt - close + i_slBuf
    float risk = f_clamp(rawRisk, i_minSl, i_maxSl)
    if rawRisk <= i_maxSl + i_slBuf
        setupDir := -1
        entryPx := close
        slPx := entryPx + risk
        tp1Px := entryPx - risk * i_tp1
        tp2Px := entryPx - risk * i_tp2
        tp3Px := entryPx - risk * i_tp3
        entryBar := bar_index
        tp1Hit := false
        tp2Hit := false
        tp3Hit := false
        slHit := false
        daySell += 1

// Manage active setup
if setupDir != 0 and not na(entryPx)
    float R = math.abs(entryPx - slPx)
    if setupDir == 1
        if not tp1Hit and high >= tp1Px
            tp1Hit := true
            dayTp1 += 1
            dayR += i_tp1
        if not tp2Hit and high >= tp2Px
            tp2Hit := true
            dayTp2 += 1
            dayR += i_tp2 - i_tp1
        if not tp3Hit and high >= tp3Px
            tp3Hit := true
            dayTp3 += 1
            dayR += i_tp3 - i_tp2
            setupDir := 0
        if not slHit and low <= slPx and not tp3Hit
            slHit := true
            daySl += 1
            // approximate R loss if no TP yet
            if not tp1Hit
                dayR -= 1.0
            setupDir := 0
    else if setupDir == -1
        if not tp1Hit and low <= tp1Px
            tp1Hit := true
            dayTp1 += 1
            dayR += i_tp1
        if not tp2Hit and low <= tp2Px
            tp2Hit := true
            dayTp2 += 1
            dayR += i_tp2 - i_tp1
        if not tp3Hit and low <= tp3Px
            tp3Hit := true
            dayTp3 += 1
            dayR += i_tp3 - i_tp2
            setupDir := 0
        if not slHit and high >= slPx and not tp3Hit
            slHit := true
            daySl += 1
            if not tp1Hit
                dayR -= 1.0
            setupDir := 0

setupTxt = setupDir == 1 ? "ACTIVE BUY" : setupDir == -1 ? "ACTIVE SELL" : buySignal or sellSignal ? "ARMED" : "WAITING"
biasTxt = biasBull ? "BULLISH" : biasBear ? "BEARISH" : "NEUTRAL"
fibTxt = fibReady ? "READY" : "WAITING"
execTxt = timeframe.multiplier == 1 ? "1M" : timeframe.multiplier == 5 ? "5M" : timeframe.period

// --- drawings ---
var box fibBox = na
var line lnEntry = na
var line lnSl = na
var line lnTp1 = na
var line lnTp2 = na
var line lnTp3 = na
var label lbEntry = na
var label lbSl = na
var label lbTp1 = na
var label lbTp2 = na
var label lbTp3 = na

f_del_line(ln) =>
    if not na(ln)
        line.delete(ln)

f_del_label(lb) =>
    if not na(lb)
        label.delete(lb)

if i_showZone and barstate.islast and not na(htfFibHi) and not na(htfFibLo)
    if not na(fibBox)
        box.delete(fibBox)
    fibBox := box.new(bar_index - 40, htfFibHi, bar_index + 10, htfFibLo, border_color=color.new(c_zone, 30), bgcolor=color.new(c_zone, 85), extend=extend.right)

if bearSweep and i_showSig
    box.new(bar_index, high, bar_index, low, border_color=color.new(c_sweep, 40), bgcolor=color.new(c_sweep, 85))

if i_showSig and buyNow
    label.new(bar_index, low, "BUY", style=label.style_label_up, color=c_buy, textcolor=color.white, size=size.small)
if i_showSig and sellNow
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=c_sell, textcolor=color.white, size=size.small)

if i_showLvls and barstate.islast and setupDir != 0 and not na(entryPx)
    f_del_line(lnEntry)
    f_del_line(lnSl)
    f_del_line(lnTp1)
    f_del_line(lnTp2)
    f_del_line(lnTp3)
    f_del_label(lbEntry)
    f_del_label(lbSl)
    f_del_label(lbTp1)
    f_del_label(lbTp2)
    f_del_label(lbTp3)
    x1 = nz(entryBar, bar_index)
    lnEntry := line.new(x1, entryPx, bar_index + 5, entryPx, extend=extend.right, color=c_entry, width=2)
    lnSl := line.new(x1, slPx, bar_index + 5, slPx, extend=extend.right, color=c_sl, width=2)
    lnTp1 := line.new(x1, tp1Px, bar_index + 5, tp1Px, extend=extend.right, color=c_tp, width=1)
    lnTp2 := line.new(x1, tp2Px, bar_index + 5, tp2Px, extend=extend.right, color=c_tp, width=1)
    lnTp3 := line.new(x1, tp3Px, bar_index + 5, tp3Px, extend=extend.right, color=c_tp, width=1)
    tag = setupDir == 1 ? "BUY ENTRY " : "SELL ENTRY "
    lbEntry := label.new(bar_index + 2, entryPx, tag + str.tostring(entryPx, format.mintick), style=label.style_label_left, color=color.new(c_entry, 20), textcolor=color.white, size=size.small)
    lbSl := label.new(bar_index + 2, slPx, "SL " + str.tostring(slPx, format.mintick), style=label.style_label_left, color=color.new(c_sl, 20), textcolor=color.white, size=size.small)
    lbTp1 := label.new(bar_index + 2, tp1Px, "TP1 " + str.tostring(tp1Px, format.mintick), style=label.style_label_left, color=color.new(c_tp, 20), textcolor=color.white, size=size.small)
    lbTp2 := label.new(bar_index + 2, tp2Px, "TP2 " + str.tostring(tp2Px, format.mintick), style=label.style_label_left, color=color.new(c_tp, 20), textcolor=color.white, size=size.small)
    lbTp3 := label.new(bar_index + 2, tp3Px, "TP3 " + str.tostring(tp3Px, format.mintick), style=label.style_label_left, color=color.new(c_tp, 20), textcolor=color.white, size=size.small)

plot(htfFibHi, "Fib High", color=color.new(c_zone, 40), linewidth=1, style=plot.style_linebr)
plot(htfFibLo, "Fib Low", color=color.new(c_zone, 40), linewidth=1, style=plot.style_linebr)

if i_showDash and barstate.islast
    var table tb = table.new(position.bottom_right, 2, 10, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray)
    table.cell(tb, 0, 0, "XAU Sweep Fib", text_color=color.aqua, text_size=size.small)
    table.cell(tb, 1, 0, "PRO style", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 1, "15M BIAS", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 1, biasTxt, text_color=biasBull ? c_buy : biasBear ? c_sell : color.yellow, text_size=size.small)
    table.cell(tb, 0, 2, "EXECUTION", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 2, execTxt, text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 3, "LIQUIDITY", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 3, liqState, text_color=liqState == "WAITING" ? color.red : color.orange, text_size=size.small)
    table.cell(tb, 0, 4, "FIB 0.50-0.60", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 4, fibTxt, text_color=fibReady ? c_buy : color.red, text_size=size.small)
    table.cell(tb, 0, 5, "SETUP", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 5, setupTxt, text_color=setupDir != 0 ? c_buy : color.yellow, text_size=size.small)
    tot = dayTp1 + dayTp2 + dayTp3 + daySl
    p1 = dayTp1 > 0 ? 100.0 : 0.0
    table.cell(tb, 0, 6, "TP1 / TP2 / TP3", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 6, str.tostring(dayTp1) + " / " + str.tostring(dayTp2) + " / " + str.tostring(dayTp3), text_color=c_tp, text_size=size.small)
    table.cell(tb, 0, 7, "SL", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 7, str.tostring(daySl), text_color=c_sl, text_size=size.small)
    table.cell(tb, 0, 8, "TODAY R", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 8, str.tostring(dayR, "#.##") + "R", text_color=dayR >= 0 ? c_buy : c_sl, text_size=size.small)
    riskNow = not na(entryPx) and not na(slPx) ? math.abs(entryPx - slPx) : na
    table.cell(tb, 0, 9, "Active R $", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 9, na(riskNow) ? "-" : str.tostring(riskNow, "#.##"), text_color=color.white, text_size=size.small)
