//@version=6
// Options Buy Decider & Targets
// For NIFTY / BANKNIFTY / SENSEX option charts (CE & PE), 1m and 5m.
//
// PURPOSE: Options BUYING only — you want option premium to rise.
//   Entry bias: breakout above Decider High toward upper Targets.
//   Exit: Target hits, or reclaim back under Decider.
//   Invalidation: close under Decider Low (or Lower Target 1).
//
// MODES:
//   INTRADAY  — Opening Range freezes after OR ends (stable day levels).
//   PREDICTION — Live rolling window (adapts as session unfolds).
//
// LADDER (same structure traders already use):
//   C = (H+L)/2 , B = (H-L)/2   [B floored by ATR so levels stay meaningful]
//   Decider = C ± 0.06·B
//   Targets = C ± {1.00, 1.54, 1.83, 2.08}·B
//
// H/L SOURCE (respect-first):
//   INTRADAY: Opening Range high/low (skip first open minutes), optional PDH/PDL widen.
//   PREDICTION: Donchian of last N bars + ATR floor.
//
indicator("Options Buy Decider & Targets", overlay = true, max_lines_count = 500, max_labels_count = 500, dynamic_requests = false)

// ── Inputs ──────────────────────────────────────────────────────────
grpMain = "Main"
enableLevels = input.bool(true, "Enable Levels", group = grpMain)
segment = input.string("INTRADAY", "Mode", options = ["INTRADAY", "PREDICTION"], group = grpMain, tooltip = "INTRADAY = frozen Opening Range. PREDICTION = live rolling lookback.")
showSignals = input.bool(true, "Show Entry / Exit Labels", group = grpMain)
showTable = input.bool(true, "Show Info Table", group = grpMain)

grpOR = "Opening Range (Intraday)"
orStartHhmm = input.int(915, "Session Start HHMM (IST)", minval = 900, maxval = 1000, group = grpOR)
orSkipMins = input.int(5, "Skip Open Noise (mins)", minval = 0, maxval = 30, group = grpOR, tooltip = "Skip auction/noise after open before OR starts.")
orMinutes = input.int(30, "OR Length (mins)", minval = 10, maxval = 90, group = grpOR, tooltip = "Opening range window length. 30 = 09:20–09:50 if skip=5.")
usePriorDay = input.bool(false, "Widen with Prior Day H/L", group = grpOR)

grpPred = "Prediction (Live)"
predLookback = input.int(50, "Lookback Bars", minval = 10, maxval = 200, group = grpPred)
predStartHhmm = input.int(915, "Ignore Before HHMM", minval = 900, maxval = 1200, group = grpPred)

grpVol = "Volatility Floor"
atrLen = input.int(14, "ATR Length", minval = 5, maxval = 50, group = grpVol)
atrFloorMult = input.float(0.75, "Min B = ATR ×", minval = 0.25, maxval = 3.0, step = 0.05, group = grpVol, tooltip = "Keeps Decider/Targets from collapsing when OR is tiny.")

grpLadder = "Ladder"
deciderFrac = input.float(0.06, "Decider ± × B", step = 0.01, group = grpLadder)
t1Ratio = input.float(1.00, "Target 1 × B", step = 0.01, group = grpLadder)
t2Ratio = input.float(1.54, "Target 2 × B", step = 0.01, group = grpLadder)
t3Ratio = input.float(1.83, "Target 3 × B", step = 0.01, group = grpLadder)
t4Ratio = input.float(2.08, "Target 4 × B", step = 0.01, group = grpLadder)

grpShow = "Show / Hide"
showDecider = input.bool(true, "Decider", group = grpShow)
showUp = input.bool(true, "Upper Targets", group = grpShow)
showDn = input.bool(true, "Lower Targets", group = grpShow)
showCenter = input.bool(false, "Centre C", group = grpShow)
showLabels = input.bool(true, "Price Labels", group = grpShow)
lineRight = input.int(40, "Line Right (bars)", minval = 5, maxval = 200, group = grpShow)
lineLeft = input.int(10, "Line Left (bars)", minval = 0, maxval = 200, group = grpShow)

grpStyle = "Colors"
clrDec = input.color(color.new(#9E9E9E, 0), "Decider", group = grpStyle)
clrT1 = input.color(color.new(#26A69A, 0), "Target 1", group = grpStyle)
clrT2 = input.color(color.new(#FF9800, 0), "Target 2", group = grpStyle)
clrT3 = input.color(color.new(#EC407A, 0), "Target 3", group = grpStyle)
clrT4 = input.color(color.new(#AB47BC, 0), "Target 4", group = grpStyle)
clrC = input.color(color.new(#787B86, 0), "Centre", group = grpStyle)
clrBuy = input.color(color.new(#00C853, 0), "Buy Label", group = grpStyle)
clrExit = input.color(color.new(#FF5252, 0), "Exit Label", group = grpStyle)
lineWidth = input.int(1, "Line Width", minval = 1, maxval = 3, group = grpStyle)

// ── Time helpers (integer-safe) ─────────────────────────────────────
tz = "Asia/Kolkata"
isIntra = segment == "INTRADAY"

f_hhmm() =>
    hour(time, tz) * 100 + minute(time, tz)

f_hhmm_at(int idx) =>
    hour(time[idx], tz) * 100 + minute(time[idx], tz)

f_add_mins(int hhmm, int mins) =>
    int h = int(hhmm / 100)
    int m = hhmm % 100
    int total = h * 60 + m + mins
    int nh = int(total / 60)
    int nm = total % 60
    nh * 100 + nm

f_same_day(int idx) =>
    dayofmonth(time[idx], tz) == dayofmonth(time, tz) and month(time[idx], tz) == month(time, tz) and year(time[idx], tz) == year(time, tz)

orWinStart = f_add_mins(orStartHhmm, orSkipMins)
orWinEnd = f_add_mins(orWinStart, orMinutes)

// ── Prior day H/L ───────────────────────────────────────────────────
f_prior_day_hl() =>
    float h = na
    float l = na
    int maxScan = math.min(bar_index, 5000)
    bool inPrior = false
    int priorD = na
    int priorM = na
    int priorY = na
    int d0 = dayofmonth(time, tz)
    int m0 = month(time, tz)
    int y0 = year(time, tz)
    for i = 1 to maxScan
        int di = dayofmonth(time[i], tz)
        int mi = month(time[i], tz)
        int yi = year(time[i], tz)
        if not (di == d0 and mi == m0 and yi == y0)
            if not inPrior
                inPrior := true
                priorD := di
                priorM := mi
                priorY := yi
                h := high[i]
                l := low[i]
            else if di == priorD and mi == priorM and yi == priorY
                h := math.max(h, high[i])
                l := math.min(l, low[i])
            else
                break
    [h, l]

[pdh, pdl] = f_prior_day_hl()

// ── Opening Range (session) ─────────────────────────────────────────
var float orH = na
var float orL = na
var int orDate = na
var bool orDone = false

sessDay = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
hhmmNow = f_hhmm()

if na(orDate) or orDate != sessDay
    orH := na
    orL := na
    orDone := false
    orDate := sessDay

inOrWindow = hhmmNow >= orWinStart and hhmmNow < orWinEnd
afterOr = hhmmNow >= orWinEnd

if isIntra and inOrWindow and not orDone
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)

if isIntra and afterOr and not na(orH) and not na(orL)
    orDone := true

// ── Prediction rolling Donchian ─────────────────────────────────────
f_pred_hl(int len, int startHhmm) =>
    float h = na
    float l = na
    int cnt = 0
    int maxScan = math.min(bar_index, 5000)
    for i = 1 to maxScan
        if cnt >= len
            break
        if f_same_day(i) and f_hhmm_at(i) >= startHhmm
            h := na(h) ? high[i] : math.max(h, high[i])
            l := na(l) ? low[i] : math.min(l, low[i])
            cnt += 1
        else if not f_same_day(i)
            break
    [h, l, cnt]

[predH, predL, predN] = f_pred_hl(predLookback, predStartHhmm)

// ── Build H / L / C / B ─────────────────────────────────────────────
atr = ta.atr(atrLen)
atrFloor = atr * atrFloorMult

rawH = isIntra ? orH : predH
rawL = isIntra ? orL : predL

if isIntra and usePriorDay and not na(pdh) and not na(pdl) and not na(rawH) and not na(rawL)
    rawH := math.max(rawH, pdh)
    rawL := math.min(rawL, pdl)

liveC = (rawH + rawL) / 2.0
liveB = math.max((rawH - rawL) / 2.0, atrFloor)

// Freeze intraday once OR complete; Prediction stays live
var float frC = na
var float frB = na
var float frH = na
var float frL = na
var int frDay = na
var string frSeg = "INIT"

needSnap = isIntra and orDone and barstate.islast and not na(liveC) and liveB > 0
segChanged = segment != frSeg or sessDay != frDay
if needSnap and (segChanged or na(frC))
    frC := liveC
    frB := liveB
    frH := rawH
    frL := rawL
    frDay := sessDay
    frSeg := segment

C = isIntra ? frC : liveC
B = isIntra ? frB : liveB
dispH = isIntra ? frH : rawH
dispL = isIntra ? frL : rawL

ready = enableLevels and not na(C) and not na(B) and B > 0

decHi = ready ? C + deciderFrac * B : na
decLo = ready ? C - deciderFrac * B : na
upT1 = ready ? C + t1Ratio * B : na
upT2 = ready ? C + t2Ratio * B : na
upT3 = ready ? C + t3Ratio * B : na
upT4 = ready ? C + t4Ratio * B : na
dnT1 = ready ? C - t1Ratio * B : na
dnT2 = ready ? C - t2Ratio * B : na
dnT3 = ready ? C - t3Ratio * B : na
dnT4 = ready ? C - t4Ratio * B : na

// ── Option BUY signals (premium rising) ─────────────────────────────
// Entry: close crosses above Decider High (breakout toward upper targets)
// Exit:  close crosses below Decider Low OR hits Upper Target 1
buyEntry = ready and showSignals and ta.crossover(close, decHi)
exitSig = ready and showSignals and (ta.crossunder(close, decLo) or ta.crossover(close, upT1))

plotshape(buyEntry, title = "BUY Option", style = shape.labelup, location = location.belowbar, color = clrBuy, text = "BUY", textcolor = color.white, size = size.small)
plotshape(exitSig, title = "EXIT / Protect", style = shape.labeldown, location = location.abovebar, color = clrExit, text = "EXIT", textcolor = color.white, size = size.small)

alertcondition(buyEntry, title = "Options BUY", message = "BUY option — breakout above Decider High")
alertcondition(exitSig, title = "Options EXIT", message = "EXIT / protect — Decider fail or Target 1 hit")

// ── Draw levels ─────────────────────────────────────────────────────
var line[] lines = array.new_line()
var label[] labels = array.new_label()

f_clear() =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
        array.clear(lines)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
        array.clear(labels)

f_level(float price, string txt, color col, bool show) =>
    if show and not na(price)
        int x1 = bar_index - lineLeft
        int x2 = bar_index + lineRight
        line ln = line.new(x1, price, x2, price, xloc = xloc.bar_index, extend = extend.none, color = col, style = line.style_dashed, width = lineWidth)
        array.push(lines, ln)
        if showLabels
            label lb = label.new(x2, price, txt + " / " + str.tostring(price, format.mintick), xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(col, 85), textcolor = col, size = size.small)
            array.push(labels, lb)

if barstate.islast and ready
    f_clear()
    if showDecider
        f_level(decHi, "Decider", clrDec, true)
        f_level(decLo, "Decider", clrDec, true)
    if showCenter
        f_level(C, "Centre", clrC, true)
    if showUp
        f_level(upT1, "Target 1", clrT1, true)
        f_level(upT2, "Target 2", clrT2, true)
        f_level(upT3, "Target 3", clrT3, true)
        f_level(upT4, "Target 4", clrT4, true)
    if showDn
        f_level(dnT1, "Target 1", clrT1, true)
        f_level(dnT2, "Target 2", clrT2, true)
        f_level(dnT3, "Target 3", clrT3, true)
        f_level(dnT4, "Target 4", clrT4, true)

// ── Data window ─────────────────────────────────────────────────────
plot(close, title = "seed", display = display.none)
plot(ready ? dispH : na, "Window High", display = display.data_window)
plot(ready ? dispL : na, "Window Low", display = display.data_window)
plot(ready ? C : na, "Centre C", display = display.data_window)
plot(ready ? B : na, "Base B", display = display.data_window)
plot(ready and showDecider ? decHi : na, "Decider High", display = display.data_window)
plot(ready and showDecider ? decLo : na, "Decider Low", display = display.data_window)

// ── Info table ──────────────────────────────────────────────────────
var table info = table.new(position.top_right, 1, 7, bgcolor = color.new(color.black, 78), border_width = 0)
if showTable and barstate.islast
    status = isIntra ? (orDone ? "FROZEN" : "building OR") : "LIVE"
    table.cell(info, 0, 0, segment + " | " + status, text_color = color.white, text_size = size.small)
    if isIntra
        table.cell(info, 0, 1, "OR " + str.tostring(orWinStart) + "-" + str.tostring(orWinEnd) + (orDone ? " done" : " …"), text_color = color.aqua, text_size = size.small)
    else
        table.cell(info, 0, 1, "lookback n=" + str.tostring(predN) + " / " + str.tostring(predLookback), text_color = color.aqua, text_size = size.small)
    hlTxt = na(dispH) ? "Waiting for range…" : ("H " + str.tostring(dispH, format.mintick) + "  L " + str.tostring(dispL, format.mintick))
    table.cell(info, 0, 2, hlTxt, text_color = color.silver, text_size = size.small)
    cbTxt = ready ? ("C " + str.tostring(C, format.mintick) + "  B " + str.tostring(B, format.mintick)) : "…"
    table.cell(info, 0, 3, cbTxt, text_color = color.yellow, text_size = size.small)
    decTxt = ready ? ("Dec " + str.tostring(decHi, format.mintick) + " / " + str.tostring(decLo, format.mintick)) : ""
    table.cell(info, 0, 4, decTxt, text_color = color.orange, text_size = size.small)
    table.cell(info, 0, 5, "BUY above Dec Hi → Targets", text_color = color.lime, text_size = size.tiny)
    table.cell(info, 0, 6, "EXIT under Dec Lo / at T1", text_color = color.gray, text_size = size.tiny)

bgcolor(color.new(color.black, 100))
