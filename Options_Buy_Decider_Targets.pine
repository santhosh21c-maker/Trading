//@version=5
indicator("Options Buy Decider Targets", overlay=true, max_labels_count=50)

// Decider + Targets as S/R on any option strike chart
// C = mid, B = half range
// Decider = C +/- 0.06*B
// Targets = C +/- 1.00, 1.54, 1.83, 2.08 * B

i_intraday = input.bool(true, "INTRADAY mode")
i_sess_start = input.int(915, "Session start HHMM", minval=0, maxval=2359)
i_skip_mins = input.int(5, "Skip first N minutes", minval=0, maxval=120)
i_or_mins = input.int(30, "OR length minutes", minval=5, maxval=180)
i_use_pd = input.bool(true, "Widen with prior day HL")
i_lookback = input.int(50, "Prediction lookback bars", minval=10, maxval=500)
i_atr_mult = input.float(0.35, "Min B ATR mult", minval=0.0, step=0.05)
i_atr_len = input.int(14, "ATR length", minval=1)
i_dec_r = input.float(0.06, "Decider ratio", step=0.01)
i_t1_r = input.float(1.00, "Target 1 ratio", step=0.01)
i_t2_r = input.float(1.54, "Target 2 ratio", step=0.01)
i_t3_r = input.float(1.83, "Target 3 ratio", step=0.01)
i_t4_r = input.float(2.08, "Target 4 ratio", step=0.01)
c_dec = input.color(color.rgb(245, 197, 66), "Decider color")
c_t1 = input.color(color.rgb(76, 175, 80), "Target 1 color")
c_t2 = input.color(color.rgb(33, 150, 243), "Target 2 color")
c_t3 = input.color(color.rgb(156, 39, 176), "Target 3 color")
c_t4 = input.color(color.rgb(233, 30, 99), "Target 4 color")
i_show_table = input.bool(true, "Show info table")
i_show_labels = input.bool(true, "Show level labels")

f_hhmm_to_min(hhmm) =>
    h = int(math.floor(hhmm / 100))
    m = hhmm % 100
    h * 60 + m

f_add_mins(hhmm, add) =>
    total = f_hhmm_to_min(hhmm) + add
    h = int(math.floor(total / 60))
    m = int(total - h * 60)
    h * 100 + m

f_in_win(t, a, b) =>
    hm = hour(t) * 100 + minute(t)
    hm >= a and hm < b

var float or_h = na
var float or_l = na
var bool or_done = false
var float H = na
var float L = na
var label lb_ud = na
var label lb_ld = na
var label lb_ut1 = na
var label lb_lt1 = na
var label lb_ut2 = na
var label lb_lt2 = na
var label lb_ut3 = na
var label lb_lt3 = na
var label lb_ut4 = na
var label lb_lt4 = na

atrv = ta.atr(i_atr_len)
or_a = f_add_mins(i_sess_start, i_skip_mins)
or_b = f_add_mins(or_a, i_or_mins)
sess_new = ta.change(time("D")) != 0
pdh = request.security(syminfo.tickerid, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

if sess_new
    or_h := na
    or_l := na
    or_done := false
    H := na
    L := na

levels_ready = false

if i_intraday
    in_or = f_in_win(time, or_a, or_b)
    if in_or and not or_done
        or_h := na(or_h) ? high : math.max(or_h, high)
        or_l := na(or_l) ? low : math.min(or_l, low)
    now_hm = hour * 100 + minute
    past_or = not or_done and not na(or_h) and not na(or_l) and not in_or and f_hhmm_to_min(now_hm) >= f_hhmm_to_min(or_b)
    if past_or
        useH = or_h
        useL = or_l
        if i_use_pd and not na(pdh) and not na(pdl)
            useH := math.max(useH, pdh)
            useL := math.min(useL, pdl)
        half = (useH - useL) * 0.5
        floorB = i_atr_mult * atrv
        if not na(floorB) and floorB > 0 and half < floorB
            mid = (useH + useL) * 0.5
            useH := mid + floorB
            useL := mid - floorB
        H := useH
        L := useL
        or_done := true
    levels_ready := or_done and not na(H) and not na(L)
else
    hh = ta.highest(high, i_lookback)
    ll = ta.lowest(low, i_lookback)
    half = (hh - ll) * 0.5
    floorB = i_atr_mult * atrv
    useH = hh
    useL = ll
    if not na(floorB) and floorB > 0 and half < floorB
        mid = (hh + ll) * 0.5
        useH := mid + floorB
        useL := mid - floorB
    H := useH
    L := useL
    levels_ready := not na(H) and not na(L) and H > L

C = float(na)
B = float(na)
UD = float(na)
LD = float(na)
UT1 = float(na)
LT1 = float(na)
UT2 = float(na)
LT2 = float(na)
UT3 = float(na)
LT3 = float(na)
UT4 = float(na)
LT4 = float(na)

if levels_ready
    C := (H + L) * 0.5
    B := (H - L) * 0.5
    UD := C + i_dec_r * B
    LD := C - i_dec_r * B
    UT1 := C + i_t1_r * B
    LT1 := C - i_t1_r * B
    UT2 := C + i_t2_r * B
    LT2 := C - i_t2_r * B
    UT3 := C + i_t3_r * B
    LT3 := C - i_t3_r * B
    UT4 := C + i_t4_r * B
    LT4 := C - i_t4_r * B

plot(UD, "Decider High", color=c_dec, linewidth=2, style=plot.style_linebr)
plot(LD, "Decider Low", color=c_dec, linewidth=2, style=plot.style_linebr)
plot(UT1, "Target 1 High", color=c_t1, linewidth=2, style=plot.style_linebr)
plot(LT1, "Target 1 Low", color=c_t1, linewidth=2, style=plot.style_linebr)
plot(UT2, "Target 2 High", color=c_t2, linewidth=1, style=plot.style_linebr)
plot(LT2, "Target 2 Low", color=c_t2, linewidth=1, style=plot.style_linebr)
plot(UT3, "Target 3 High", color=c_t3, linewidth=1, style=plot.style_linebr)
plot(LT3, "Target 3 Low", color=c_t3, linewidth=1, style=plot.style_linebr)
plot(UT4, "Target 4 High", color=c_t4, linewidth=2, style=plot.style_linebr)
plot(LT4, "Target 4 Low", color=c_t4, linewidth=2, style=plot.style_linebr)

if i_show_labels and barstate.islast and levels_ready
    if not na(lb_ud)
        label.delete(lb_ud)
    if not na(lb_ld)
        label.delete(lb_ld)
    if not na(lb_ut1)
        label.delete(lb_ut1)
    if not na(lb_lt1)
        label.delete(lb_lt1)
    if not na(lb_ut2)
        label.delete(lb_ut2)
    if not na(lb_lt2)
        label.delete(lb_lt2)
    if not na(lb_ut3)
        label.delete(lb_ut3)
    if not na(lb_lt3)
        label.delete(lb_lt3)
    if not na(lb_ut4)
        label.delete(lb_ut4)
    if not na(lb_lt4)
        label.delete(lb_lt4)
    lb_ud := label.new(bar_index + 2, UD, "Decider High " + str.tostring(UD), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_dec, 80), textcolor=c_dec, size=size.small)
    lb_ld := label.new(bar_index + 2, LD, "Decider Low " + str.tostring(LD), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_dec, 80), textcolor=c_dec, size=size.small)
    lb_ut1 := label.new(bar_index + 2, UT1, "Target 1 High " + str.tostring(UT1), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_t1, 80), textcolor=c_t1, size=size.small)
    lb_lt1 := label.new(bar_index + 2, LT1, "Target 1 Low " + str.tostring(LT1), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_t1, 80), textcolor=c_t1, size=size.small)
    lb_ut2 := label.new(bar_index + 2, UT2, "Target 2 High " + str.tostring(UT2), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_t2, 80), textcolor=c_t2, size=size.small)
    lb_lt2 := label.new(bar_index + 2, LT2, "Target 2 Low " + str.tostring(LT2), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_t2, 80), textcolor=c_t2, size=size.small)
    lb_ut3 := label.new(bar_index + 2, UT3, "Target 3 High " + str.tostring(UT3), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_t3, 80), textcolor=c_t3, size=size.small)
    lb_lt3 := label.new(bar_index + 2, LT3, "Target 3 Low " + str.tostring(LT3), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_t3, 80), textcolor=c_t3, size=size.small)
    lb_ut4 := label.new(bar_index + 2, UT4, "Target 4 High " + str.tostring(UT4), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_t4, 80), textcolor=c_t4, size=size.small)
    lb_lt4 := label.new(bar_index + 2, LT4, "Target 4 Low " + str.tostring(LT4), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(c_t4, 80), textcolor=c_t4, size=size.small)

if i_show_table and barstate.islast and levels_ready
    var table tb = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20))
    mode_txt = i_intraday ? "INTRADAY" : "PREDICTION"
    st = "LIVE"
    if i_intraday
        st := or_done ? "FROZEN" : "Building OR"
    table.cell(tb, 0, 0, "Mode", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 0, mode_txt, text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 1, "H / L", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 1, str.tostring(H) + " / " + str.tostring(L), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 2, "Decider", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 2, str.tostring(UD) + " / " + str.tostring(LD), text_color=c_dec, text_size=size.small)
    table.cell(tb, 0, 3, "Target 1", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 3, str.tostring(UT1) + " / " + str.tostring(LT1), text_color=c_t1, text_size=size.small)
    table.cell(tb, 0, 4, "Target 2", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 4, str.tostring(UT2) + " / " + str.tostring(LT2), text_color=c_t2, text_size=size.small)
    table.cell(tb, 0, 5, "Target 3", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 5, str.tostring(UT3) + " / " + str.tostring(LT3), text_color=c_t3, text_size=size.small)
    table.cell(tb, 0, 6, "Target 4", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 6, str.tostring(UT4) + " / " + str.tostring(LT4), text_color=c_t4, text_size=size.small)
    table.cell(tb, 0, 7, "Status", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 7, st, text_color=color.aqua, text_size=size.small)
